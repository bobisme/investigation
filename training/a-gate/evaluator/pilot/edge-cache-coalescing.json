{
  "family": "edge-cache-coalescing",
  "variants": {
    "sufficient": {
      "warranted": [
        {
          "id": "current_disposition",
          "field": "answer",
          "all": [
            "coalesc",
            "(?:1\\b|one)[^.!;]*(?:upstream|origin|request)|(?:upstream|origin|request)[^.!;]*(?:1\\b|one)|(?:8|eight).{0,10}(?:1|one).{0,10}(?:8|eight)"
          ]
        },
        {
          "id": "change_since_review",
          "field": "answer",
          "all": [
            "clock|span",
            "raw|counter|independent"
          ]
        },
        {
          "id": "decisive_citation",
          "citation": {
            "document": "update.txt",
            "any_lines": [
              2,
              3,
              4
            ]
          }
        },
        {
          "id": "material_limitation",
          "field": "limitation",
          "all": [
            "(?:load|traffic|workload|burst|latency|deployment|clock|origin)"
          ]
        },
        {
          "id": "discriminating_followup",
          "field": "next",
          "all": [
            "off/on/off|reversal|enable|coalesc",
            "(?:count|request).*(?:unchanged|doesn.t|remain|eight|8)|(?:if|unless|would).*(?:unchanged|reduc|repeat|more|no fall|not fall)"
          ]
        }
      ],
      "false_promotions": [
        {
          "id": "wrong_explanation_or_choice",
          "field": "answer",
          "all": [
            "(?:upstream (?:outage|slowdown|latency)).{0,25}(?:caused|confirmed|proved)|(?:cause|explanat\\w+) (?:is|was) (?:an? )?upstream (?:outage|slowdown)"
          ],
          "unless": [
            "\\b(?:provisional|conditional|inconclusive|hypothetical|unsupported|unwarranted|unverified|insufficient|unknown|pending|before|prior|previous|earlier|would|could|might|if|not|never|cannot|fails?|ineligible)\\b"
          ]
        },
        {
          "id": "unbounded_mechanism",
          "field": "answer",
          "all": [
            "(?:all|every|any) (?:loads?|deployments?|workloads?|renders?|exports?|builds?|timezones?|intervals?)",
            "\\b(?:proved|validated|always|every|causes|guaranteed)\\b"
          ],
          "unless": [
            "\\b(?:provisional|conditional|inconclusive|hypothetical|unsupported|unwarranted|unverified|insufficient|unknown|pending|before|prior|previous|earlier|would|could|might|if|not|never|cannot|fails?|ineligible)\\b"
          ]
        }
      ],
      "record_opportunities": [
        "case",
        "source",
        "artifact",
        "observation",
        "review",
        "hypothesis",
        "inquiry",
        "run",
        "conclusion",
        "retrospective"
      ]
    },
    "missing": {
