    "sufficient": {
      "warranted": [
        {
          "id": "current_disposition",
          "field": "answer",
          "all": [
            "local.shard",
            "select|recommend|choose|prefer|only eligible|qualif|switch|meets"
          ]
        },
        {
          "id": "change_since_review",
          "field": "answer",
          "all": [
            "off.line|offline",
            "isolation|neighbou?r|other (?:team|department)|extract"
          ]
        },
        {
          "id": "decisive_citation",
          "citation": {
            "document": "update.txt",
            "any_lines": [
              2,
              3,
