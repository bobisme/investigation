        },
        {
          "id": "decisive_citation",
          "citation": {
            "document": "update.txt",
            "any_lines": [
              1,
              2,
              3,
              4
            ]
          }
        },
        {
          "id": "material_limitation",
          "field": "limitation",
          "all": [
            "profile|pixel|exported (?:files|image)|confound"
          ]
        },
        {
          "id": "discriminating_followup",
          "field": "next",
          "all": [
