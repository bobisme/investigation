{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A-gate paired assignment record",
  "type": "object",
  "required": ["assignment", "environment", "budgets", "boundary", "phases"],
  "properties": {
    "assignment": {
      "type": "object",
      "required": ["id", "family", "variant", "domain", "arm", "block_seed", "order"],
      "properties": {
        "id": {"type": "string"},
        "family": {"type": "string"},
        "variant": {"type": "string"},
        "domain": {"enum": ["debugging", "architecture", "lookup"]},
        "arm": {"enum": ["notes", "inv"]},
        "block_seed": {"type": "integer"},
        "order": {"enum": [1, 2]}
      }
    },
    "environment": {
      "type": "object",
      "required": ["decision_adr_commit", "fixture_commit", "binary_commit", "binary_sha256", "runner_sha256", "model", "provider", "inference", "host", "tools"]
    },
    "budgets": {"type": "object", "required": ["investigator", "successor"]},
    "boundary": {
      "type": "object",
      "required": ["review_status", "update_sha256", "interruption", "work_digest"]
    },
    "phases": {
      "type": "object",
      "required": ["investigator", "successor"],
      "properties": {
        "investigator": {"$ref": "#/$defs/phase"},
        "successor": {"$ref": "#/$defs/phase"}
      }
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "required": ["session_id", "status", "input_tokens", "output_tokens", "tool_calls", "elapsed_ms", "discovery_bytes", "evidence_bytes", "note_read_bytes", "note_write_bytes", "preparation_calls", "first_receipt_call", "transcript"],
      "properties": {
        "session_id": {"type": "string"},
        "status": {"enum": ["completed", "timed_out", "budget_exhausted", "crashed", "invalidated"]},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "discovery_bytes": {"type": "integer", "minimum": 0},
        "evidence_bytes": {"type": "integer", "minimum": 0},
        "note_read_bytes": {"type": "integer", "minimum": 0},
        "note_write_bytes": {"type": "integer", "minimum": 0},
        "preparation_calls": {"type": "integer", "minimum": 0},
        "first_receipt_call": {"type": ["integer", "null"], "minimum": 1},
        "transcript": {"type": "string"}
      }
    }
  }
}
