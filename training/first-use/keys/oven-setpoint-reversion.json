{
  "family": "oven-setpoint-reversion",
  "role": "comparison",
  "variants": {
    "default": {
      "warranted": [
        {
          "id": "current_answer",
          "field": "answer",
          "all": [
            "230|power[- ]?save|factory default|default setpoint|setpoint (?:restor|revert|reset)|revert|reset"
          ]
        },
        {
          "id": "decisive_citation",
          "citation": {
            "document": "source.txt",
            "any_lines": [
              12,
              15,
              18,
              22
            ]
          }
        },
        {
          "id": "material_limitation",
          "field": "limitation",
          "all": [
            "clock|47|minute|not (?:yet )?(?:been )?tested|untested|no (?:monday )?(?:bake|test)|align|lined? up|timing"
          ]
        }
      ],
      "false_promotions": [
        {
          "id": "overclaimed_cause",
          "field": "answer",
          "all": [
            "\\b(?:confirmed|proven|definitive(?:ly)?|conclusively|established beyond)\\b"
          ],
          "unless": [
            "\\b(?:provisional|conditional|inconclusive|hypothe\\w*|unsupported|unwarranted|unverified|insufficient|unknown|pending|likely|probabl\\w*|suggest\\w*|appears?|would|could|might|may|if|not|never|cannot|no|until|whether|claim\\w*|newsletter|reports?)\\b"
          ]
        }
      ]
    }
  }
}
