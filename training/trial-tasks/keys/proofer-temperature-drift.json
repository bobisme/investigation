          "all": [
            "(?:sensor|S-A)[^.;]*\\b(?:faulty|defective|failed|failing|drifts?|drifting|miscalibrated|broken|needs? (?:recalibration|replacement))\\b"
          ],
          "unless": [
            "\\b(?:not|no|rather than|instead|ruled|wasn't|was not|isn't|is not|earlier|original\\w*|previous\\w*|colleague|thought|unlikely|without)\\b"
