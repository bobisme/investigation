{
  "schema_version": "inv.release-task-instance.v1",
  "task": 10,
  "id": "batching-bench-retrospective",
  "split": "development",
  "domain": "measurement",
  "description": "Development copy of adversarial drills 5 and 6: the invalid-benchmark measurement case of crates/investigation-cli/tests/drill_lesson_transfer.rs, with a baseline run, an inquiry and the bench-notes method pack of fixtures/method-packs adopted by the case. The patched run is recorded invalid (the load generator saturated first), so the case can only close inconclusive.",
  "objective": "The case cannot be taken further. Close it so that a later investigation can learn from what happened.",
  "setup": {
    "base": {"init": true, "sources": [{"from": "fixtures/method-packs/bench-notes.toml", "as": "bench-notes.toml"}]},
    "steps": [
      {"record": {"case": null, "actor": "agent:bench-author", "operations": [
        {"op": "case.create", "payload": {"title": "Does the batching patch cut p99 latency?", "mode": "measure"}}]},
       "bind": {"case": "/created/0"}},
      {"cli": ["ingest", "--input", "-"],
       "stdin": {"schema_version": "inv.ingest.v1", "command_id": "retain-pack", "actor": "agent:bench-author",
                 "case_id": {"$": "case/id"}, "source": {"title": "Bench notes method pack", "format": "application/toml"},
                 "paths": ["bench-notes.toml"]},
       "as": "pack"},
      {"find": {"case": {"kind": "case", "where": {"/mode": "measure"}}}},
      {"record": {"actor": "agent:bench-author", "preconditions": [{"$": "case"}], "operations": [
        {"op": "method_pack.adopt", "payload": {"artifact_ref": {"id": {"$": "pack/items/0/artifact_id"}, "revision": 1},
          "pack_id": "bench-notes", "version": "1.0.0", "digest": {"$": "pack/items/0/digest"},
          "reason": "Use the team's benchmark bookkeeping guidance."}}]}},
      {"record": {"actor": "agent:bench-author", "operations": [
        {"op": "question.create", "client_ref": "question", "payload": {"wording": "Does the batching patch cut p99 latency under open-loop load?", "importance": "high"}},
        {"op": "hypothesis.create", "payload": {"question_ref": {"client_ref": "question"}, "statement": "Batching cuts p99 by amortising the per-request flush.",
          "assumption_refs": [], "rival_refs": [], "possible_falsifiers": ["p99 is unchanged with batching on at the same offered load."]}},
        {"op": "inquiry.create", "payload": {"purpose": "Measure p99 before and after batching.",
          "method": "Open-loop load against one host, batching off and then on.", "inquiry": {"mode": "exploratory"},
          "desired_observations": ["p99 with batching off and on at the same offered load."], "controls": [], "limits": ["One shared host."]}}]},
       "bind": {"question": "/created/0", "hypothesis": "/created/1", "inquiry": "/created/2"}},
      {"record": {"actor": "agent:bench-author", "operations": [
        {"op": "run.record", "payload": {"intent": {"kind": "exploration", "intent": "Measure p99 with batching off."},
          "producer": "agent:load-generator", "artifact_refs": [], "execution_status": "completed",
          "evidence_completeness": "complete", "evidence_kind": "observational", "evidence_validity": "valid", "variables_changed": []}}]},
       "bind": {"baseline_run": "/created/0"}},
      {"record": {"actor": "agent:bench-author", "operations": [
        {"op": "run.record", "client_ref": "patched", "payload": {"intent": {"kind": "exploration", "intent": "Measure p99 with batching on."},
          "producer": "agent:load-generator", "artifact_refs": [], "execution_status": "completed",
          "evidence_completeness": "complete", "evidence_kind": "observational", "evidence_validity": "invalid", "variables_changed": []}},
        {"op": "annotation.add", "payload": {"subject_refs": [{"client_ref": "patched"}], "content": {"kind": "text",
          "text": "The load generator reached full CPU before the service did, so the offered load fell below target during the patched run."}}}]},
       "bind": {"patched_run": "/created/0"}}
    ]
  },
  "key": {
    "allowed_outcomes": ["inconclusive", "abandoned"],
    "max_lessons": 3,
    "max_text_chars": 6000,
    "checkable_anchors": [
      "The patched run is invalid because the load generator saturated before the service (cites the run.invalid digest item).",
      "A rerun with generator headroom at the same offered load would answer the question.",
      "A lesson scoped to closed- or open-loop load tests on one shared host, with that transfer limit stated."
    ]
  },
  "rehearsal": {
    "correct": {
      "steps": [
        {"cli": ["--case", {"$": "case/id"}, "brief", "--level", "compact"]},
        {"cli": ["--case", {"$": "case/id"}, "retrospective", "--draft"], "as": "draft"},
        {"find": {"case": {"kind": "case", "where": {"/mode": "measure"}}}},
        {"record": {"actor": "agent:closer", "preconditions": [{"$": "case"}], "operations": [
          {"op": "retrospective.record", "client_ref": "account", "payload": {"$merge": [{"$": "draft/record_template"}, {
            "methods_attempted": [{"name": "Open-loop load test, batching off and then on", "inquiry_ref": {"$": "inquiry/id"}}],
            "effective_steps": [{"description": "The baseline run with batching off completed with valid evidence.", "support_refs": [{"$": "baseline_run/id"}]}],
            "invalid_or_misleading_steps": [{"description": "The patched run is invalid: the load generator saturated before the service, so its p99 says nothing about batching.",
              "support_refs": [{"$": "draft/items/[cite={patched_run/id}]/cite"}]}],
            "costs_or_constraints": "One shared host ran both the generator and the service.",
            "residual_unknowns": ["Whether batching changes p99 at the same offered load."],
            "lessons": [{"guidance": "Confirm the load generator keeps CPU headroom through the run before reading its p99.",
              "applies_when": "Load tests that drive one host from a generator on shared hardware.",
              "support_refs": [{"$": "draft/items/[cite={patched_run/id}]/cite"}],
              "transfer_limits": "One benchmark on one host; other load models may saturate differently."}]}]}},
          {"op": "case.close", "payload": {"outcome": "inconclusive", "reason": "The only patched run was invalid.",
            "unresolved_questions": [{"$": "question"}], "reopen_condition": "A patched run with generator headroom at the same offered load.",
            "retrospective_ref": {"client_ref": "account"}}}]}}
      ]
    },
    "faults": [
      {"id": "account-then-close", "fails": ["closed_in_one_transaction", "no_separate_retrospective"],
       "steps": [
         {"correct": true, "set": {
           "/3/record/operations/1": {"op": "annotation.add", "payload": {"subject_refs": [{"client_ref": "account"}],
             "content": {"kind": "text", "text": "Closing next."}}},
           "/3/bind": {"account": "/created/0"}}},
         {"find": {"case": {"kind": "case", "where": {"/mode": "measure"}}}},
         {"record": {"actor": "agent:closer", "preconditions": [{"$": "case"}], "operations": [
           {"op": "case.close", "payload": {"outcome": "inconclusive", "reason": "The only patched run was invalid.",
             "unresolved_questions": [{"$": "question"}], "reopen_condition": null, "retrospective_ref": {"$": "account"}}}]}}]},
      {"id": "invented-failure", "fails": ["no_invented_failure"],
       "steps": [
         {"correct": true, "set": {"/3/record/operations/0/payload/$merge/1/invalid_or_misleading_steps/-": {
           "description": "The baseline run was misleading: the host was noisy.", "support_refs": [{"$": "baseline_run/id"}]}}}]},
      {"id": "fabricated-failure", "fails": ["no_invented_failure", "no_new_failure_records"],
       "steps": [
         {"record": {"actor": "agent:closer", "operations": [
           {"op": "run.record", "payload": {"intent": {"kind": "exploration", "intent": "Re-measure p99 with batching off."},
             "producer": "agent:closer", "artifact_refs": [], "execution_status": "failed",
             "evidence_completeness": "missing", "evidence_kind": "observational", "evidence_validity": "invalid", "variables_changed": []}}]},
          "bind": {"fabricated": "/created/0"}},
         {"correct": true, "set": {"/3/record/operations/0/payload/$merge/1/invalid_or_misleading_steps/-": {
           "description": "A rerun of the baseline also failed.", "support_refs": [{"$": "fabricated/id"}]}}}]},
      {"id": "failure-omitted", "fails": ["recorded_failure_accounted"],
       "steps": [
         {"correct": true, "set": {"/3/record/operations/0/payload/$merge/1/invalid_or_misleading_steps": [], "/3/record/operations/0/payload/$merge/1/none_observed_reason": "No step failed.",
           "/3/record/operations/0/payload/$merge/1/lessons": [], "/3/record/operations/0/payload/$merge/1/no_reusable_lesson_reason": "Nothing went wrong."}}]},
      {"id": "unbounded", "fails": ["bounded"],
       "steps": [
         {"correct": true, "set": {"/3/record/operations/0/payload/$merge/1/lessons": [
           {"guidance": "Confirm generator headroom before reading p99.", "applies_when": "Load tests on shared hardware.", "support_refs": [{"$": "draft/items/[cite={patched_run/id}]/cite"}], "transfer_limits": "One benchmark on one host."},
           {"guidance": "Record generator CPU beside every run.", "applies_when": "Load tests on shared hardware.", "support_refs": [{"$": "draft/items/[cite={patched_run/id}]/cite"}], "transfer_limits": "One benchmark on one host."},
           {"guidance": "Run the generator on its own host.", "applies_when": "Load tests on shared hardware.", "support_refs": [{"$": "draft/items/[cite={patched_run/id}]/cite"}], "transfer_limits": "One benchmark on one host."},
           {"guidance": "Repeat each run at the same offered load.", "applies_when": "Load tests on shared hardware.", "support_refs": [{"$": "draft/items/[cite={patched_run/id}]/cite"}], "transfer_limits": "One benchmark on one host."}]}}]},
      {"id": "self-admitted-lesson", "fails": ["no_lesson_admitted"],
       "steps": [
         {"correct": true, "set": {"/3/bind": {"account": "/created/0"}}},
         {"record": {"actor": "agent:closer", "actor_descriptor": {"kind": "human"}, "operations": [
           {"op": "lesson.admit", "payload": {"retrospective_ref": {"$": "account"}, "lesson_index": 0,
             "basis": {"kind": "human_review", "rationale": "The cited run shows the saturated generator."}}}]}}]},
      {"id": "pack-edited", "fails": ["packs_and_configuration_unchanged"],
       "steps": [
         {"correct": true},
         {"edit": {"path": "bench-notes.toml", "append": "\n# Lesson: confirm generator headroom before reading p99.\n"}}]}
    ]
  }
}
