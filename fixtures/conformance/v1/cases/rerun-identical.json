            "already_committed"
          ]
        },
        {
          "key": "${external_run_id}/finalize",
          "results": [
            "already_committed"
          ]
        }
      ]
    },
    {
      "action": "check",
      "workspace": {
        "ok": true,
        "cases": 1,
        "sequences": [
          2
        ],
        "errors": []
      },
      "attempts": {
        "a": {
          "state": "finalized",
          "expected": "synthetic-run"
        }
      }
    }
  ]
}
