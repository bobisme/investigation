# Tool-owned projection generated by Investigation: the Retrospectives and Lessons view of one case.
# The static table with the same rows: Cases/case_01a20751-966e-78f0-9f9c-f07db6650063/Views/Retrospectives and Lessons.md
# Editing this file, or a cell in its table (which changes a note's properties), is drift.
filters:
  and:
    - "inv_case_id == \"case_01a20751-966e-78f0-9f9c-f07db6650063\""
    - "inv_kind == \"retrospective\""
properties:
  file.name:
    displayName: "Record ID"
  aliases:
    displayName: "Title"
  inv_status:
    displayName: "Status"
  inv_freshness:
    displayName: "Freshness"
  inv_basis_sequence:
    displayName: "Basis sequence"
  inv_revision:
    displayName: "Rev"
views:
  - type: table
    name: "Retrospectives and Lessons"
    order:
      - file.name
      - aliases
      - inv_status
      - inv_freshness
      - inv_basis_sequence
      - inv_revision
