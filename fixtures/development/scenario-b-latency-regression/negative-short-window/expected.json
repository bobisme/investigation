          "fixture.observation_window_below_intended",
          "measurement.quantile_below_order_statistic_bound"
        ],
        "optimization-a-short": [
          "measurement.flat_samples",
          "fixture.monitor_self_check_failed",
          "fixture.observation_window_below_intended",
          "measurement.quantile_below_order_statistic_bound"
        ]
      }
    }
  ]
