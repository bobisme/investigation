    "title": "SelectorRequest",
    "type": "object"
  },
  "help": {
    "help": "Preserve evidence, test explanations, and evaluate options.\n\nUsage: investigation [OPTIONS] <COMMAND>\n\nCommands:\n  init      Create a local workspace and an optional Obsidian vault\n  record    Submit one atomic transaction using the operation catalog\n  ingest    Preserve original local bytes and return their acquisition IDs\n  start     Open an exploratory case and retain one attachment atomically\n  evidence  Inspect retained source material explicitly\n  capture   Record an external producer's run through the inv.capture.v1 protocol\n  schema    Discover operation schemas, examples, and repairs\n  onboard   Learn the model and inspect the next valid local action\n  next      Rank up to three snapshot-bound investigative gaps\n  frontier  List every snapshot-bound gap with filters, paging and rule explanations\n  guide     Print one method card from the built-in pack or a pinned pack\n  method    List method packs and their cards\n  receipt   Look up a command without resubmitting its original input\n  show      Read a case record at title, summary, or full depth\n  brief     Read a bounded handoff from the verified case snapshot\n  search    Find records by text; results are labelled pointers, not evidence\n  check     Verify the journal, blobs, and index without repairing them\n  repair    Rebuild derived workspace data\n  observe   Record one source-bound text observation.\n  note      Attach one narrative note without evidentiary standing.\n  case      Create and inspect case-level items.\n  source    Add source material through verified ingest.\n  help      Print this message or the help of the given subcommand(s)\n\nOptions:\n      --workspace <PATH>  Open this workspace instead of discovering the nearest investigation.toml\n      --case <ID>         Select a case by full ID or unique case_ prefix\n      --actor <ACTOR>     Attribute actions to this actor, or use workspace settings or AGENT\n      --format <FORMAT>   Select text or a single machine-readable JSON object [possible values: text, json]\n      --read-only         Reject commands that write workspace data\n      --no-color          Suppress terminal colors\n      --no-pager          Write directly to stdout\n  -h, --help              Print help\n  -V, --version           Print version\n\nUse investigation when a question needs multiple observations, a comparison, or a handoff.\nThe workspace preserves evidence and attributed revisions. Writes return a durable receipt.\n\n  investigation onboard --format json\n  investigation init ./casework --no-vault --format json\n  investigation schema case.create --format json\n  investigation --workspace ./casework next --format json\n  investigation case new 'Request latency' --format json\n  investigation source add ./results.log --case <ID> --format json\n  investigation observe 'The log reports 28 seconds' --source <ARTIFACT_ID> --quote 'waited 28 seconds' --format json\n  investigation note 'Check the clock source' --on <RECORD_ID> --format json\n  investigation --workspace ./casework record --input case.json --format json\n  investigation --workspace ./casework receipt KEY --actor ACTOR --format json\n\nUse schema record for the transaction envelope and schema --list for operations.\nGenerated shortcut command IDs appear on stderr before writes; reconcile with receipt KEY.\nUse --print-envelope to inspect a shortcut request without writing.\n",
    "ok": true,
    "result": "help",
    "schema_version": "inv.response.v1"
  },
  "missing_workspace": {
    "commit_status": "not_committed",
    "error": {
      "code": "WORKSPACE_REQUIRED",
      "message": "no investigation.toml found from <WORKING_DIRECTORY> up to the filesystem root Run investigation init PATH or pass --workspace PATH.",
      "repair": {
        "argv": [
          "investigation",
          "onboard",
          "--format",
          "json"
        ]
      }
    },
    "ok": false,
    "result": "rejected",
    "schema_version": "inv.response.v1"
  },
