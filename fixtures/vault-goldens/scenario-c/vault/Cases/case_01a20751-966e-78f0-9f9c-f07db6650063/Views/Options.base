# Tool-owned projection generated by Investigation: the Options view of one case.
# The static table with the same rows: Cases/case_01a20751-966e-78f0-9f9c-f07db6650063/Views/Options.md
# Editing this file, or a cell in its table (which changes a note's properties), is drift.
filters:
  and:
    - "inv_case_id == \"case_01a20751-966e-78f0-9f9c-f07db6650063\""
    - "inv_kind == \"option\""
properties:
  file.name:
    displayName: "Record ID"
  aliases:
    displayName: "Title"
  inv_status:
    displayName: "Status"
  inv_effective:
    displayName: "Effective state"
  inv_open_gaps:
    displayName: "Open gaps"
  inv_revision:
    displayName: "Rev"
views:
  - type: table
    name: "Options"
    order:
      - file.name
      - aliases
      - inv_status
      - inv_effective
      - inv_open_gaps
      - inv_revision
