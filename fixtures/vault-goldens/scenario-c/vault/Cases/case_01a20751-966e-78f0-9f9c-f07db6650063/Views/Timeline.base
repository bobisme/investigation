# Tool-owned projection generated by Investigation: the Timeline view of one case.
# The static table with the same rows: Cases/case_01a20751-966e-78f0-9f9c-f07db6650063/Views/Timeline.md
# Editing this file, or a cell in its table (which changes a note's properties), is drift.
filters:
  and:
    - "inv_case_id == \"case_01a20751-966e-78f0-9f9c-f07db6650063\""
    - "inv_kind != \"view\""
properties:
  file.name:
    displayName: "Record ID"
  aliases:
    displayName: "Title"
  inv_kind:
    displayName: "Kind"
  inv_revision:
    displayName: "Rev"
  inv_updated:
    displayName: "Recorded"
  inv_status:
    displayName: "Status"
views:
  - type: table
    name: "Timeline"
    order:
      - file.name
      - aliases
      - inv_kind
      - inv_revision
      - inv_updated
      - inv_status
