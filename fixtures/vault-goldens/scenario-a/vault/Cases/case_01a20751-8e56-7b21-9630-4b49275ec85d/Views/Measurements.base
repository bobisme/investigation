# Tool-owned projection generated by Investigation: the Measurements view of one case.
# The static table with the same rows: Cases/case_01a20751-8e56-7b21-9630-4b49275ec85d/Views/Measurements.md
# Editing this file, or a cell in its table (which changes a note's properties), is drift.
filters:
  and:
    - "inv_case_id == \"case_01a20751-8e56-7b21-9630-4b49275ec85d\""
    - and:
        - "inv_kind == \"observation\""
        - "inv_value_kind == \"measurement\""
properties:
  file.name:
    displayName: "Record ID"
  aliases:
    displayName: "Title"
  inv_status:
    displayName: "Status"
  inv_basis:
    displayName: "Basis"
  inv_selector_validation:
    displayName: "Selector"
  inv_evidentiary_use:
    displayName: "Evidentiary use"
  inv_effective:
    displayName: "Effective state"
  inv_revision:
    displayName: "Rev"
views:
  - type: table
    name: "Measurements"
    order:
      - file.name
      - aliases
      - inv_status
      - inv_basis
      - inv_selector_validation
      - inv_evidentiary_use
      - inv_effective
      - inv_revision
