# Tool-owned projection generated by Investigation: the Epistemic Frontier view of one case.
# The static table with the same rows: Cases/case_01a20751-8e56-7b21-9630-4b49275ec85d/Views/Epistemic Frontier.md
# Editing this file, or a cell in its table (which changes a note's properties), is drift.
filters:
  and:
    - "inv_case_id == \"case_01a20751-8e56-7b21-9630-4b49275ec85d\""
    - and:
        - "inv_kind != \"view\""
        - "inv_open_gaps > 0"
properties:
  file.name:
    displayName: "Record ID"
  aliases:
    displayName: "Title"
  inv_kind:
    displayName: "Kind"
  inv_open_gaps:
    displayName: "Open gaps"
  inv_effective:
    displayName: "Effective state"
  inv_status:
    displayName: "Status"
views:
  - type: table
    name: "Epistemic Frontier"
    order:
      - file.name
      - aliases
      - inv_kind
      - inv_open_gaps
      - inv_effective
      - inv_status
