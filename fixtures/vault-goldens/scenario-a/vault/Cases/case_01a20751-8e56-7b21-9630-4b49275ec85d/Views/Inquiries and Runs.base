# Tool-owned projection generated by Investigation: the Inquiries and Runs view of one case.
# The static table with the same rows: Cases/case_01a20751-8e56-7b21-9630-4b49275ec85d/Views/Inquiries and Runs.md
# Editing this file, or a cell in its table (which changes a note's properties), is drift.
filters:
  and:
    - "inv_case_id == \"case_01a20751-8e56-7b21-9630-4b49275ec85d\""
    - or:
        - "inv_kind == \"inquiry\""
        - "inv_kind == \"run\""
properties:
  file.name:
    displayName: "Record ID"
  aliases:
    displayName: "Title"
  inv_kind:
    displayName: "Kind"
  inv_status:
    displayName: "Status"
  inv_effective:
    displayName: "Effective state"
  inv_open_gaps:
    displayName: "Open gaps"
  inv_revision:
    displayName: "Rev"
views:
  - type: table
    name: "Inquiries and Runs"
    order:
      - file.name
      - aliases
      - inv_kind
      - inv_status
      - inv_effective
      - inv_open_gaps
      - inv_revision
