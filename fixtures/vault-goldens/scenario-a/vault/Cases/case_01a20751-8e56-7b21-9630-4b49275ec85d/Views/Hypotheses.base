# Tool-owned projection generated by Investigation: the Hypotheses view of one case.
# The static table with the same rows: Cases/case_01a20751-8e56-7b21-9630-4b49275ec85d/Views/Hypotheses.md
# Editing this file, or a cell in its table (which changes a note's properties), is drift.
filters:
  and:
    - "inv_case_id == \"case_01a20751-8e56-7b21-9630-4b49275ec85d\""
    - "inv_kind == \"hypothesis\""
properties:
  file.name:
    displayName: "Record ID"
  aliases:
    displayName: "Title"
  inv_status:
    displayName: "Standing"
  inv_effective:
    displayName: "Effective state"
  inv_review_freshness:
    displayName: "Review freshness"
  inv_open_gaps:
    displayName: "Open gaps"
  inv_revision:
    displayName: "Rev"
views:
  - type: table
    name: "Hypotheses"
    order:
      - file.name
      - aliases
      - inv_status
      - inv_effective
      - inv_review_freshness
      - inv_open_gaps
      - inv_revision
