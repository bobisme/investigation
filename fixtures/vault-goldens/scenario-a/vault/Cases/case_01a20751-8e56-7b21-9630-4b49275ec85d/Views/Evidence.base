# Tool-owned projection generated by Investigation: the Evidence view of one case.
# The static table with the same rows: Cases/case_01a20751-8e56-7b21-9630-4b49275ec85d/Views/Evidence.md
# Editing this file, or a cell in its table (which changes a note's properties), is drift.
filters:
  and:
    - "inv_case_id == \"case_01a20751-8e56-7b21-9630-4b49275ec85d\""
    - or:
        - "inv_kind == \"artifact\""
        - and:
            - "inv_kind == \"observation\""
            - "inv_value_kind != \"measurement\""
properties:
  file.name:
    displayName: "Record ID"
  aliases:
    displayName: "Title"
  inv_kind:
    displayName: "Kind"
  inv_artifact_role:
    displayName: "Role"
  inv_integrity:
    displayName: "Integrity"
  inv_availability:
    displayName: "Availability"
  inv_selector_validation:
    displayName: "Selector"
  inv_evidentiary_use:
    displayName: "Evidentiary use"
  inv_revision:
    displayName: "Rev"
views:
  - type: table
    name: "Evidence"
    order:
      - file.name
      - aliases
      - inv_kind
      - inv_artifact_role
      - inv_integrity
      - inv_availability
      - inv_selector_validation
      - inv_evidentiary_use
      - inv_revision
