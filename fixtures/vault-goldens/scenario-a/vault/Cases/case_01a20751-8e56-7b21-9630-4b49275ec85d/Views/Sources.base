# Tool-owned projection generated by Investigation: the Sources view of one case.
# The static table with the same rows: Cases/case_01a20751-8e56-7b21-9630-4b49275ec85d/Views/Sources.md
# Editing this file, or a cell in its table (which changes a note's properties), is drift.
filters:
  and:
    - "inv_case_id == \"case_01a20751-8e56-7b21-9630-4b49275ec85d\""
    - "inv_kind == \"source\""
properties:
  file.name:
    displayName: "Record ID"
  aliases:
    displayName: "Title"
  inv_status:
    displayName: "Status"
  inv_source_access:
    displayName: "Access"
  inv_assessed:
    displayName: "Assessed"
  inv_effective:
    displayName: "Effective state"
  inv_revision:
    displayName: "Rev"
views:
  - type: table
    name: "Sources"
    order:
      - file.name
      - aliases
      - inv_status
      - inv_source_access
      - inv_assessed
      - inv_effective
      - inv_revision
