# Tool-owned projection generated by Investigation: the Reviews and Blindspots view of one case.
# The static table with the same rows: Cases/case_01a20751-8e56-7b21-9630-4b49275ec85d/Views/Reviews and Blindspots.md
# Editing this file, or a cell in its table (which changes a note's properties), is drift.
filters:
  and:
    - "inv_case_id == \"case_01a20751-8e56-7b21-9630-4b49275ec85d\""
    - "inv_kind == \"review\""
properties:
  file.name:
    displayName: "Record ID"
  aliases:
    displayName: "Title"
  inv_review_kind:
    displayName: "Review kind"
  inv_verdict:
    displayName: "Verdict"
  inv_freshness:
    displayName: "Freshness"
  inv_basis_sequence:
    displayName: "Basis sequence"
  inv_status:
    displayName: "Status"
  inv_revision:
    displayName: "Rev"
views:
  - type: table
    name: "Reviews and Blindspots"
    order:
      - file.name
      - aliases
      - inv_review_kind
      - inv_verdict
      - inv_freshness
      - inv_basis_sequence
      - inv_status
      - inv_revision
