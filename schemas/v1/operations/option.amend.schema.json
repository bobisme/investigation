{
  "$defs": {
    "Id": {
      "pattern": "^(case|q|src|art|obs|hyp|asm|opt|crit|cmp|assess|concl|dec|rev|obj|ann|retro|inq|run|tx|handle|checkpoint|import|ws)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "RevisionRef": {
      "additionalProperties": false,
      "description": "An exact revision already issued by the store.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    }
  },
  "$id": "urn:investigation:schema:v1:operation:option.amend",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context": {
      "type": [
        "string",
        "null"
      ]
    },
    "dependencies": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "description": {
      "type": "string"
    },
    "feasibility": {
      "type": [
        "string",
        "null"
      ]
    },
    "option_ref": {
      "$ref": "#/$defs/RevisionRef"
    },
    "reason": {
      "type": "string"
    },
    "tradeoff_notes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "option_ref",
    "reason",
    "description",
    "dependencies",
    "tradeoff_notes"
  ],
  "title": "OptionAmend",
  "type": "object"
}
