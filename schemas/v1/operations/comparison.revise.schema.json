{
  "$defs": {
    "AbsenceBasis": {
      "additionalProperties": false,
      "description": "The basis of a record that treats \"nothing was seen\" as evidence. Every\nfield is optional so that the absence itself is always recordable; the gate\nreports what is missing.",
      "properties": {
        "detection_limit": {
          "description": "The recorder's statement of the detection limits. Shown with the human\nquestion; the core does not judge it.",
          "type": [
            "string",
            "null"
          ]
        },
        "expected_signal": {
          "description": "What would have been observed if the effect, fact or difference were\npresent.",
          "type": [
            "string",
            "null"
          ]
        },
        "justified_equivalent": {
          "description": "A justified substitute for an instrument or control validity\njudgment, used only where the cited Observations have none. It never\noverrides an `invalid` or `partial` judgment.",
          "type": [
            "string",
            "null"
          ]
        },
        "opportunity": {
          "anyOf": [
            {
              "$ref": "#/$defs/AbsenceOpportunity"
            },
            {
              "type": "null"
            }
          ],
          "description": "The sampling or search that would have shown the signal."
        }
      },
      "type": "object"
    },
    "AbsenceOpportunity": {
      "additionalProperties": false,
      "description": "The Runs or Observations that would have shown the expected signal, and\nthe adequacy standard they had to meet.",
      "properties": {
        "description": {
          "type": "string"
        },
        "minimum_observation_window": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "description": "Smallest observation window each cited record must record, in the\nrecorded unit. Units are not converted."
        },
        "minimum_sample_count": {
          "description": "Smallest sample count each cited record must record.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "refs": {
          "default": [],
          "description": "Exact Run or Observation revisions.",
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "type": "array"
        }
      },
      "required": [
        "description"
      ],
      "type": "object"
    },
    "ClientRef": {
      "additionalProperties": false,
      "description": "An alias of a record created by an earlier operation in this transaction.",
      "properties": {
        "client_ref": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "client_ref"
      ],
      "type": "object"
    },
    "ComparisonBasis": {
      "description": "An explicit qualitative preference is not an objective measurement.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "preference",
              "type": "string"
            },
            "statement": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "statement"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "qualitative",
              "type": "string"
            },
            "statement": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "statement"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unknown",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "ComparisonInput": {
      "additionalProperties": false,
      "properties": {
        "absence": {
          "anyOf": [
            {
              "$ref": "#/$defs/AbsenceBasis"
            },
            {
              "type": "null"
            }
          ],
          "description": "Marks the comparison as resting on an absence. See `absence_gate`."
        },
        "assumption_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceInput"
          },
          "type": "array"
        },
        "basis": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComparisonBasis"
            },
            {
              "type": "null"
            }
          ]
        },
        "criterion_ref": {
          "$ref": "#/$defs/Reference"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceInput"
          },
          "type": "array"
        },
        "limitations": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": "string"
        },
        "option_ref": {
          "$ref": "#/$defs/Reference"
        },
        "outcome": {
          "$ref": "#/$defs/ComparisonOutcome"
        },
        "rationale": {
          "type": "string"
        },
        "uncertainty": {
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Measurement"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "option_ref",
        "criterion_ref",
        "outcome",
        "method",
        "evidence_refs",
        "assumption_refs",
        "uncertainty",
        "rationale"
      ],
      "type": "object"
    },
    "ComparisonOutcome": {
      "enum": [
        "meets",
        "fails",
        "partially_meets",
        "unknown",
        "not_applicable"
      ],
      "type": "string"
    },
    "DecimalString": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "type": "string"
    },
    "EvidenceInput": {
      "anyOf": [
        {
          "$ref": "#/$defs/Id"
        },
        {
          "$ref": "#/$defs/Reference"
        }
      ],
      "description": "Bare IDs preserve the plan's example; they are resolved to current revisions before storage."
    },
    "Id": {
      "pattern": "^(case|q|src|art|obs|hyp|asm|opt|crit|cmp|assess|concl|dec|rev|obj|ann|retro|inq|run|tx|handle|checkpoint|import|ws)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "decimal": {
          "$ref": "#/$defs/DecimalString"
        },
        "sample_count": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "statistic": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "decimal",
        "unit"
      ],
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "A decimal quantity with its unit.",
      "properties": {
        "unit": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/DecimalString"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "type": "object"
    },
    "Reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/RevisionRef"
        },
        {
          "$ref": "#/$defs/ClientRef"
        }
      ]
    },
    "RevisionRef": {
      "additionalProperties": false,
      "description": "An exact revision already issued by the store.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    }
  },
  "$id": "urn:investigation:schema:v1:operation:comparison.revise",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "comparison_ref": {
      "$ref": "#/$defs/RevisionRef"
    },
    "reason": {
      "type": "string"
    },
    "replacement": {
      "$ref": "#/$defs/ComparisonInput"
    }
  },
  "required": [
    "comparison_ref",
    "reason",
    "replacement"
  ],
  "title": "ComparisonRevise",
  "type": "object"
}
