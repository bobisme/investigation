{
  "$defs": {
    "Actor": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:_.-]+$",
      "type": "string"
    },
    "EvidenceKind": {
      "enum": [
        "observational",
        "interventional"
      ],
      "type": "string"
    },
    "Id": {
      "pattern": "^(case|q|src|art|obs|hyp|asm|opt|crit|cmp|assess|concl|dec|rev|obj|ann|retro|inq|run|tx|handle|checkpoint|import|ws)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "RevisionRef": {
      "additionalProperties": false,
      "description": "An exact revision already issued by the store.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    },
    "RunIntent": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "plan",
              "type": "string"
            },
            "plan_ref": {
              "$ref": "#/$defs/RevisionRef"
            }
          },
          "required": [
            "kind",
            "plan_ref"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "intent": {
              "type": "string"
            },
            "kind": {
              "const": "exploration",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "intent"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "urn:investigation:schema:v1:operation:run.start",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "environment": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_kind": {
      "$ref": "#/$defs/EvidenceKind"
    },
    "external_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "intent": {
      "$ref": "#/$defs/RunIntent"
    },
    "producer": {
      "$ref": "#/$defs/Actor"
    },
    "tool": {
      "type": [
        "string",
        "null"
      ]
    },
    "variables_changed": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "intent",
    "producer",
    "evidence_kind"
  ],
  "title": "RunStart",
  "type": "object"
}
