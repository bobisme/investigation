{
  "$defs": {
    "CaseClosureOutcome": {
      "enum": [
        "answered",
        "chosen",
        "inconclusive",
        "abandoned",
        "superseded"
      ],
      "type": "string"
    },
    "ClientRef": {
      "additionalProperties": false,
      "description": "An alias of a record created by an earlier operation in this transaction.",
      "properties": {
        "client_ref": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "client_ref"
      ],
      "type": "object"
    },
    "Id": {
      "pattern": "^(case|q|src|art|obs|hyp|asm|opt|crit|cmp|assess|concl|dec|rev|obj|ann|retro|inq|run|tx|handle|checkpoint|import|ws)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/RevisionRef"
        },
        {
          "$ref": "#/$defs/ClientRef"
        }
      ]
    },
    "RevisionRef": {
      "additionalProperties": false,
      "description": "An exact revision already issued by the store.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    }
  },
  "$id": "urn:investigation:schema:v1:operation:case.close",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Close a case. Order: resolve each Question with `question.resolve`, then\ntake the draft (`retrospective --draft`), then `retrospective.record` and\n`case.close`; all three may share one transaction, in that order.",
  "properties": {
    "outcome": {
      "$ref": "#/$defs/CaseClosureOutcome"
    },
    "reason": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
    },
    "reopen_condition": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrospective_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reference"
        },
        {
          "type": "null"
        }
      ],
      "description": "Existing or same-transaction Retrospective. Mutually exclusive with waiver."
    },
    "retrospective_waived": {
      "description": "A short reason for omitting a Retrospective on a non-material case.",
      "maxLength": 2048,
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "unresolved_questions": {
      "description": "Questions left unresolved, each at its current revision. Outcome\n`answered` is refused while a Question is open and not listed here.",
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "type": "array"
    }
  },
  "required": [
    "outcome",
    "reason",
    "unresolved_questions"
  ],
  "title": "CaseClose",
  "type": "object"
}
