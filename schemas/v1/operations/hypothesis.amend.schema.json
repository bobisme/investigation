{
  "$defs": {
    "ClientRef": {
      "additionalProperties": false,
      "description": "An alias of a record created by an earlier operation in this transaction.",
      "properties": {
        "client_ref": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "client_ref"
      ],
      "type": "object"
    },
    "HypothesisCreate": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "type": [
            "string",
            "null"
          ]
        },
        "assumption_refs": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "type": "array"
        },
        "possible_falsifiers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "question_ref": {
          "$ref": "#/$defs/Reference"
        },
        "rival_refs": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "type": "array"
        },
        "statement": {
          "type": "string"
        }
      },
      "required": [
        "question_ref",
        "statement",
        "possible_falsifiers",
        "rival_refs",
        "assumption_refs"
      ],
      "type": "object"
    },
    "Id": {
      "pattern": "^(case|q|src|art|obs|hyp|asm|opt|crit|cmp|assess|concl|dec|rev|obj|ann|retro|inq|run|tx|handle|checkpoint|import|ws)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/RevisionRef"
        },
        {
          "$ref": "#/$defs/ClientRef"
        }
      ]
    },
    "RevisionRef": {
      "additionalProperties": false,
      "description": "An exact revision already issued by the store.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    }
  },
  "$id": "urn:investigation:schema:v1:operation:hypothesis.amend",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "hypothesis_ref": {
      "$ref": "#/$defs/RevisionRef"
    },
    "rationale": {
      "type": "string"
    },
    "replacement": {
      "$ref": "#/$defs/HypothesisCreate"
    }
  },
  "required": [
    "hypothesis_ref",
    "replacement",
    "rationale"
  ],
  "title": "HypothesisAmend",
  "type": "object"
}
