{
  "$defs": {
    "AttemptCount": {
      "additionalProperties": false,
      "description": "One attempt count and what it counts.",
      "properties": {
        "count": {
          "$ref": "#/$defs/Knowledge3"
        },
        "definition": {
          "$ref": "#/$defs/Knowledge"
        }
      },
      "required": [
        "count",
        "definition"
      ],
      "type": "object"
    },
    "AttemptCounts": {
      "additionalProperties": false,
      "description": "Started, observed, timed-out, excluded and unknown attempt counts. Each is\nkept as recorded; the core does not reconcile one count against another.",
      "properties": {
        "excluded": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptCount"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptCount"
            },
            {
              "type": "null"
            }
          ]
        },
        "started": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptCount"
            },
            {
              "type": "null"
            }
          ]
        },
        "timed_out": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptCount"
            },
            {
              "type": "null"
            }
          ]
        },
        "unknown": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptCount"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "ClientRef": {
      "additionalProperties": false,
      "description": "An alias of a record created by an earlier operation in this transaction.",
      "properties": {
        "client_ref": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "client_ref"
      ],
      "type": "object"
    },
    "ClockQuality": {
      "enum": [
        "unknown",
        "unverified",
        "synchronized",
        "attested"
      ],
      "type": "string"
    },
    "DecimalString": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "type": "string"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "EvidenceKind": {
      "enum": [
        "observational",
        "interventional"
      ],
      "type": "string"
    },
    "Id": {
      "pattern": "^(case|q|src|art|obs|hyp|asm|opt|crit|cmp|assess|concl|dec|rev|obj|ann|retro|inq|run|tx|handle|checkpoint|import|ws)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Knowledge": {
      "description": "Explicit unknown is distinct from a known zero, empty string, or empty list.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "known",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "Knowledge10": {
      "description": "Explicit unknown is distinct from a known zero, empty string, or empty list.",
