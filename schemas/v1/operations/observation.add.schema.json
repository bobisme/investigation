    "LoadLoop": {
      "oneOf": [
        {
          "const": "open",
          "description": "Work arrives on its own schedule, whether or not earlier work finished.",
          "type": "string"
        },
        {
          "const": "closed",
          "description": "New work waits for earlier work to finish.",
          "type": "string"
        }
      ]
    },
    "LoadModel": {
      "additionalProperties": false,
      "properties": {
        "loop": {
          "$ref": "#/$defs/Knowledge6"
        },
        "timed_from_intended_send": {
          "$ref": "#/$defs/Knowledge7",
          "description": "Whether each duration is measured from the intended send time rather\nthan the actual send time."
        }
      },
      "required": [
        "loop",
        "timed_from_intended_send"
      ],
      "type": "object"
    },
    "MeasurementFields": {
      "additionalProperties": false,
      "description": "Optional typed measurement fields. Absent means not recorded; `unknown`\nmeans recorded as explicitly unknown.",
      "properties": {
        "attempts": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptCounts"
            },
            {
              "type": "null"
            }
          ],
          "description": "Attempt accounting, each count with its definition."
        },
        "environment_identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge8"
            },
            {
              "type": "null"
            }
          ],
          "description": "Structured identity of the environment measured in."
        },
        "instrumentation_changed": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge7"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether instrumentation changed relative to the runs this one is compared with."
        },
        "limitations": {
          "description": "Limits of these measurement conditions.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "load_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge5"
            },
            {
              "type": "null"
            }
          ],
          "description": "How load was generated, for measurements taken under generated load."
        },
        "observation_window": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge2"
            },
            {
              "type": "null"
            }
          ],
          "description": "Length of the window in which samples were taken."
        },
        "sample_count": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge3"
            },
            {
              "type": "null"
            }
          ],
          "description": "Number of samples the reported value rests on, as stated by the recorder."
        },
        "samples": {
          "anyOf": [
            {
              "$ref": "#/$defs/SampleSet"
            },
            {
              "type": "null"
            }
          ],
          "description": "Raw samples, flat or carrying their repetition level and order."
        },
        "statistic": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge9"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the reported value summarizes, such as a quantile of the samples.\nDescriptive only: the core never computes the statistic."
        },
        "tool_identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge8"
            },
            {
              "type": "null"
            }
          ],
          "description": "Structured identity of the instrument or tool that measured."
        },
        "trial_order": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge4"
            },
            {
              "type": "null"
            }
          ],
          "description": "Order in which compared trials or conditions were run."
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge"
            },
            {
              "type": "null"
            }
          ],
          "description": "Unit of the measured quantity. On an Observation with a measurement\nvalue, a known unit must equal `value.unit`."
        },
        "warmup": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge2"
            },
            {
              "type": "null"
            }
          ],
          "description": "Settling or warm-up period excluded before the observation window."
        },
        "workload": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge"
            },
            {
              "type": "null"
            }
          ],
          "description": "Identity of the workload, input set or procedure that was measured."
        }
      },
      "type": "object"
    },
    "MeasurementValidity": {
      "enum": [
        "unknown",
        "valid",
        "invalid",
        "partial"
      ],
      "type": "string"
    },
    "ObservationBasisRequest": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "artifact_ref": {
              "$ref": "#/$defs/Reference",
              "description": "Distinguishes acquisitions even when their artifact bytes deduplicate."
            },
            "kind": {
              "const": "source",
              "type": "string"
            },
            "selector": {
              "$ref": "#/$defs/SelectorRequest"
            },
            "text_quote": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TextQuoteRequest"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "artifact_ref",
            "selector"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Explicitly attributed assertion, not a source-backed observation.",
          "properties": {
            "assertion": {
              "type": "string"
            },
            "context": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "assertion",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "assertion"
          ],
          "type": "object"
        }
      ]
    },
    "ObservationValue": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "text",
              "type": "string"
            },
            "statement": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "statement"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "measurement",
              "type": "string"
            },
            "unit": {
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/DecimalString"
            }
          },
          "required": [
            "kind",
            "value",
            "unit"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "digest": {
              "$ref": "#/$defs/Digest"
            },
            "kind": {
              "const": "binary",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "digest"
          ],
          "type": "object"
        }
      ]
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "A decimal quantity with its unit.",
      "properties": {
        "unit": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/DecimalString"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "type": "object"
    },
    "Reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/RevisionRef"
        },
        {
          "$ref": "#/$defs/ClientRef"
        }
      ]
    },
    "RevisionRef": {
      "additionalProperties": false,
      "description": "An exact revision already issued by the store.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    },
    "Sample": {
      "additionalProperties": false,
      "description": "One raw sample with its repetition level (build, process, iteration).",
      "properties": {
        "build": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge"
            },
            {
              "type": "null"
            }
          ]
        },
        "iteration": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge3"
            },
            {
              "type": "null"
            }
          ]
        },
        "order": {
          "$ref": "#/$defs/Knowledge3",
          "description": "Position in acquisition order. Known positions are unique within a set."
        },
        "process": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "$ref": "#/$defs/DecimalString"
        }
      },
      "required": [
        "value",
        "order"
      ],
      "type": "object"
    },
    "SampleSet": {
      "description": "Raw samples. A flat array is accepted; it carries no repetition level or\nacquisition order beyond its array position.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "shape": {
              "const": "flat",
              "type": "string"
            },
            "unit": {
              "type": "string"
            },
            "values": {
              "items": {
                "$ref": "#/$defs/DecimalString"
              },
              "type": "array"
            }
          },
          "required": [
            "shape",
            "unit",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Each sample states its repetition level and acquisition order.",
          "properties": {
            "samples": {
              "items": {
                "$ref": "#/$defs/Sample"
              },
              "type": "array"
            },
            "shape": {
              "const": "leveled",
              "type": "string"
            },
            "unit": {
              "type": "string"
            }
          },
          "required": [
            "shape",
            "unit",
            "samples"
          ],
          "type": "object"
        }
      ]
    },
    "SelectorKind": {
      "description": "The actual discriminated union. `EvidenceSelector` binds this to a digest\nand a core-computed validation result.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "whole",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "end": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "start": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "byte_range",
              "type": "string"
            }
          },
          "required": [
            "type",
            "start",
            "end"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "encoding": {
              "type": "string"
            },
            "end_line": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "parser_version": {
              "type": "string"
            },
            "start_line": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "text_lines",
              "type": "string"
            }
          },
          "required": [
            "type",
            "start_line",
            "end_line",
            "encoding",
            "parser_version"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "exact": {
              "type": "string"
            },
            "prefix": {
              "type": [
                "string",
                "null"
              ]
            },
            "suffix": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "text_quote",
              "type": "string"
            }
          },
          "required": [
            "type",
            "exact"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "parser": {
              "type": [
                "string",
                "null"
              ]
            },
            "pointer": {
              "type": "string"
            },
            "type": {
              "const": "json_pointer",
              "type": "string"
            }
          },
          "required": [
            "type",
            "pointer"
          ],
          "type": "object"
        },
