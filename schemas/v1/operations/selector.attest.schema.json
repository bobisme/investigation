{
  "$defs": {
    "AttestedOutcome": {
      "description": "What the attesting reader found. `unavailable` and `unverified` are not\noutcomes of a check, so they cannot be attested.",
      "enum": [
        "verified",
        "ambiguous",
        "not_found"
      ],
      "type": "string"
    },
    "DecimalString": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "type": "string"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "Id": {
      "pattern": "^(case|q|src|art|obs|hyp|asm|opt|crit|cmp|assess|concl|dec|rev|obj|ann|retro|inq|run|tx|handle|checkpoint|import|ws)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "RevisionRef": {
      "additionalProperties": false,
      "description": "An exact revision already issued by the store.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    },
    "SelectorKind": {
      "description": "The actual discriminated union. `EvidenceSelector` binds this to a digest\nand a core-computed validation result.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "whole",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "end": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "start": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "byte_range",
              "type": "string"
            }
          },
          "required": [
            "type",
            "start",
            "end"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "encoding": {
              "type": "string"
            },
            "end_line": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "parser_version": {
              "type": "string"
            },
            "start_line": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "text_lines",
              "type": "string"
            }
          },
          "required": [
            "type",
            "start_line",
            "end_line",
            "encoding",
            "parser_version"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "exact": {
              "type": "string"
            },
            "prefix": {
              "type": [
                "string",
                "null"
              ]
            },
            "suffix": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "text_quote",
              "type": "string"
            }
          },
          "required": [
            "type",
            "exact"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "parser": {
              "type": [
                "string",
                "null"
              ]
            },
            "pointer": {
              "type": "string"
            },
            "type": {
              "const": "json_pointer",
              "type": "string"
            }
          },
          "required": [
            "type",
            "pointer"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A cell of a named table. `extraction_version` names the reader that\nproduced the table; the core resolves only its own declared delimited\nreaders, `inv.table.csv.v1` and `inv.table.tsv.v1`, and never guesses a\ndelimiter. `row_index` is zero-based over data rows after the header row;\n`row_identity` is the exact value of `key_column` in the selected row.",
          "properties": {
            "column": {
              "type": "string"
            },
            "extraction_version": {
              "type": "string"
            },
            "key_column": {
              "description": "Header of the column that holds `row_identity`. Without it a\n`row_identity` cannot be checked and the selector stays `unavailable`.",
              "type": [
                "string",
                "null"
              ]
            },
            "row_identity": {
              "type": [
                "string",
                "null"
              ]
            },
            "row_index": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "table": {
              "type": "string"
            },
            "type": {
              "const": "table_cell",
              "type": "string"
            }
          },
          "required": [
            "type",
            "table",
            "column",
            "extraction_version"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "channel": {
              "type": "string"
            },
            "coordinate_origin": {
              "type": "string"
            },
            "end": {
              "$ref": "#/$defs/DecimalString"
            },
            "start": {
              "$ref": "#/$defs/DecimalString"
            },
            "type": {
              "const": "time_window",
              "type": "string"
            },
            "unit": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "start",
            "end",
            "unit",
            "coordinate_origin",
            "channel"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "blob_digest": {
              "$ref": "#/$defs/Digest"
            },
            "commit": {
              "type": "string"
            },
            "end_line": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "path": {
              "type": "string"
            },
            "repository": {
              "type": "string"
            },
            "start_line": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "code_span",
              "type": "string"
            }
          },
          "required": [
            "type",
            "repository",
            "commit",
            "blob_digest",
            "path",
            "start_line",
            "end_line"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "type": "string"
            },
            "schema_uri": {
              "type": "string"
            },
            "schema_version": {
              "type": "string"
            },
            "type": {
              "const": "external_selector",
              "type": "string"
            },
            "validator": {
              "type": [
                "string",
                "null"
              ]
            },
            "value": true
          },
          "required": [
            "type",
            "namespace",
            "schema_uri",
            "schema_version",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "SelectorRequest": {
      "additionalProperties": false,
      "description": "Request form deliberately lacks a validation field.",
      "properties": {
        "artifact_digest": {
          "$ref": "#/$defs/Digest"
        },
        "schema_version": {
          "$ref": "#/$defs/SelectorVersion"
        },
        "selector": {
          "$ref": "#/$defs/SelectorKind"
        }
      },
      "required": [
        "schema_version",
        "artifact_digest",
        "selector"
      ],
      "type": "object"
    },
    "SelectorVersion": {
      "description": "The selector schema is versioned independently from record and command schemas.",
      "enum": [
        "inv.selector.v1"
      ],
      "type": "string"
    },
    "ValidatorIdentity": {
      "additionalProperties": false,
      "description": "The reader or validator that performed the check, as self-reported.",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    }
  },
  "$id": "urn:investigation:schema:v1:operation:selector.attest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "extraction_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/RevisionRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Exact derivative Artifact the reader extracted from the cited\nArtifact while checking, if it kept one."
    },
    "limits": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "observation_ref": {
      "$ref": "#/$defs/RevisionRef",
      "description": "Exact current Observation revision whose selector was checked."
    },
    "outcome": {
      "$ref": "#/$defs/AttestedOutcome"
    },
    "rationale": {
      "type": "string"
    },
    "selector": {
      "$ref": "#/$defs/SelectorRequest",
      "description": "The selector request exactly as the Observation records it: what the\nreader checked. It must equal the Observation's selector."
    },
    "validator": {
      "$ref": "#/$defs/ValidatorIdentity"
    }
  },
  "required": [
    "observation_ref",
    "selector",
    "outcome",
    "validator",
    "rationale"
  ],
  "title": "SelectorAttest",
  "type": "object"
}
