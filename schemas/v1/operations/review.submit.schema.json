{
  "$defs": {
    "BlindspotVerdict": {
      "enum": [
        "gaps_identified",
        "no_gap_identified_within_scope",
        "inconclusive"
      ],
      "type": "string"
    },
    "ClientRef": {
      "additionalProperties": false,
      "description": "An alias of a record created by an earlier operation in this transaction.",
      "properties": {
        "client_ref": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "client_ref"
      ],
      "type": "object"
    },
    "ContextIsolation": {
      "enum": [
        "same_session_self_review",
        "fresh_context_unblinded",
        "fresh_context_blinded",
        "external_evidence_backed"
      ],
      "type": "string"
    },
    "Dependence": {
      "enum": [
        "shared",
        "partly_shared",
        "independent_on_stated_dimensions",
        "unknown"
      ],
      "type": "string"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "GapDisposition": {
      "additionalProperties": false,
      "description": "A disposition of one `gap_id` reported by the reviewed audit.",
      "properties": {
        "disposition": {
          "$ref": "#/$defs/GapDispositionKind"
        },
        "gap_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "record_refs": {
          "default": [],
          "description": "Records that record or address the gap, including ones created earlier\nin the same transaction.",
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "type": "array"
        },
        "related_refs": {
          "default": [],
          "description": "Revisions the reviewer read for this gap. A reference that the reviewed\naudit's finding lists (in its `subject_refs` or `related_refs`) is\naccepted as given, even at an earlier revision or beside another\nrevision of the same record; the current revision of its record, when\nactive, must then be in `read_set`. Any other reference must be the\ncurrent revision, one per record, and is also in `read_set`.",
          "items": {
            "$ref": "#/$defs/RevisionRef"
          },
          "type": "array"
        },
        "uncertainty": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "gap_id",
        "disposition",
        "reason"
      ],
      "type": "object"
    },
    "GapDispositionKind": {
      "description": "What the reviewer concluded about one gap the audit reported.",
      "oneOf": [
        {
          "const": "accepted",
          "description": "The gap is real and still open.",
          "type": "string"
        },
        {
          "const": "addressed",
          "description": "Recorded work answers the gap; `record_refs` names it.",
          "type": "string"
        },
        {
          "const": "not_applicable",
          "description": "The gap does not bear on the reviewed scope, for the stated reason.",
          "type": "string"
        }
      ]
    },
    "Id": {
      "pattern": "^(case|q|src|art|obs|hyp|asm|opt|crit|cmp|assess|concl|dec|rev|obj|ann|retro|inq|run|tx|handle|checkpoint|import|ws)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Knowledge": {
      "description": "Explicit unknown is distinct from a known zero, empty string, or empty list.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "known",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "Knowledge2": {
      "description": "Explicit unknown is distinct from a known zero, empty string, or empty list.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "known",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/ReviewWorkKind"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "Knowledge3": {
      "description": "Explicit unknown is distinct from a known zero, empty string, or empty list.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "known",
              "type": "string"
            },
            "value": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "NovelGap": {
      "additionalProperties": false,
      "description": "A gap the reviewer identified that no registered check reports.",
      "properties": {
        "record_refs": {
          "default": [],
          "description": "The Question, Assumption or Objection that records this gap, typically\ncreated earlier in the same transaction and cited by `client_ref`.",
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "type": "array"
        },
        "related_refs": {
          "default": [],
          "description": "Current revisions the gap concerns; each is also in `read_set`.",
          "items": {
            "$ref": "#/$defs/RevisionRef"
          },
          "type": "array"
        },
        "statement": {
          "type": "string"
        },
        "uncertainty": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "statement"
      ],
      "type": "object"
    },
    "Reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/RevisionRef"
        },
        {
          "$ref": "#/$defs/ClientRef"
        }
      ]
    },
    "ReviewContext": {
      "additionalProperties": false,
      "properties": {
        "activity": {
          "type": "string"
        },
        "dependence_basis": {
          "type": "string"
        },
        "dependencies": {
          "$ref": "#/$defs/Dependence"
        },
        "gathered_new_evidence": {
          "$ref": "#/$defs/Knowledge"
        },
        "method_or_source_changes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "prior_involvement": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge3"
            },
            {
              "type": "null"
            }
          ],
          "description": "The reviewer's prior involvement with the subject, in the reviewer's\nwords: authored it, gathered its evidence, advised on it. Known and\nempty declares none. Absent reads as undeclared."
        },
        "read_other_reviews": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether the reviewer read another review of the same subject before\nrecording this one. Reviews named in `read_set` are recorded reads\nwhatever this says. Absent reads as undeclared."
        },
        "saw_original_conclusion": {
          "$ref": "#/$defs/Knowledge"
        },
        "work_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge2"
            },
            {
              "type": "null"
            }
          ],
          "description": "Self-review, independent interpretation, rerun or independent-method\nvalidation. Absent reads as undeclared, which views show as unknown."
        }
      },
      "required": [
        "saw_original_conclusion",
        "gathered_new_evidence",
        "method_or_source_changes",
        "activity",
        "dependencies",
        "dependence_basis"
      ],
      "type": "object"
    },
    "ReviewWorkKind": {
      "description": "The kind of work a review was (§14.2). Declared, never inferred.",
      "enum": [
        "self_review",
        "independent_interpretation",
        "rerun",
        "independent_method_validation"
      ],
      "type": "string"
    },
    "ReviewedAudit": {
      "additionalProperties": false,
      "description": "The structural audit a blindspot review read. Copy the fields from the\n`investigation blindspots` response; its snapshot is the review's\n`audited_snapshot`.",
      "properties": {
        "check_set_digest": {
          "$ref": "#/$defs/Digest",
          "description": "The response's `check_set_digest`."
        },
        "check_version": {
          "description": "The response's `check_version`.",
          "type": "string"
        },
        "subject_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The response's `scope.subject_ref` for an audit narrowed with\n`--subject`. Omit it for a whole-case audit."
        }
      },
      "required": [
        "check_version",
        "check_set_digest"
      ],
      "type": "object"
    },
    "RevisionRef": {
      "additionalProperties": false,
      "description": "An exact revision already issued by the store.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    },
    "Snapshot": {
      "additionalProperties": false,
      "properties": {
        "head_hash": {
          "$ref": "#/$defs/Digest"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "head_hash"
      ],
      "type": "object"
    },
    "ValidationVerdict": {
      "enum": [
        "supports",
        "objects",
        "inconclusive"
      ],
      "type": "string"
    }
  },
  "$id": "urn:investigation:schema:v1:operation:review.submit",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "basis_digest": {
          "$ref": "#/$defs/Digest",
          "description": "The `basis_digest` of the subject's `review_basis`, from `review-packet ID` or, for a\nConclusion or Decision, `show ID --depth full`."
        },
        "caveats": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/ReviewContext"
        },
        "context_isolation": {
          "$ref": "#/$defs/ContextIsolation"
        },
        "kind": {
          "const": "validation",
          "type": "string"
        },
        "materials_examined": {
          "description": "Evidence the reviewer examined: Observations, Assessments, Artifacts, Sources, Runs,\nComparisons or Conclusions of this case. Each must also be in `read_set`.",
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "type": "array"
        },
        "method": {
          "type": "string"
        },
        "objection_refs": {
          "description": "Objections on the subject that the review answers. A `supports` verdict must cite\nevery open Objection on the subject (ADR 0017). Each must also be in `read_set`.",
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "type": "array"
        },
        "read_set": {
          "description": "Exact current revisions the reviewer read: every record in the subject's\n`review_basis.read_set`, plus each record cited in `materials_examined` and\n`objection_refs`. The subject itself may be left out. One revision per record.",
          "items": {
            "$ref": "#/$defs/RevisionRef"
          },
          "type": "array"
        },
        "shared_dependencies": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "subject_ref": {
          "$ref": "#/$defs/Reference",
          "description": "The Conclusion, Decision or Comparison reviewed, at its current revision."
        },
        "verdict": {
          "$ref": "#/$defs/ValidationVerdict"
        }
      },
      "required": [
        "kind",
        "subject_ref",
        "basis_digest",
        "read_set",
        "method",
        "materials_examined",
        "shared_dependencies",
        "objection_refs",
        "verdict",
        "caveats",
        "context_isolation",
        "context"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "assumption_refs": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "type": "array"
        },
        "audit": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewedAudit"
            },
            {
              "type": "null"
            }
          ],
          "description": "The structural audit this review read, if any."
        },
        "audited_snapshot": {
          "$ref": "#/$defs/Snapshot"
        },
        "checks_considered": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/ReviewContext"
        },
        "context_isolation": {
          "$ref": "#/$defs/ContextIsolation"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "type": "array"
        },
        "gap_dispositions": {
          "description": "Dispositions of gap IDs the reviewed audit reported.",
          "items": {
            "$ref": "#/$defs/GapDisposition"
          },
          "type": "array"
        },
        "gaps": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "const": "blindspot",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "method": {
          "type": "string"
        },
        "no_gap_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "novel_gaps": {
          "description": "Gaps the reviewer identified outside the registered checks.",
          "items": {
            "$ref": "#/$defs/NovelGap"
          },
          "type": "array"
        },
        "read_set": {
          "items": {
            "$ref": "#/$defs/RevisionRef"
          },
          "type": "array"
        },
        "scope_examined": {
          "type": "string"
        },
        "subject_ref": {
          "$ref": "#/$defs/Reference"
        },
        "verdict": {
          "$ref": "#/$defs/BlindspotVerdict"
        }
      },
      "required": [
        "kind",
        "subject_ref",
        "audited_snapshot",
        "read_set",
        "method",
        "scope_examined",
        "checks_considered",
        "gaps",
        "evidence_refs",
        "assumption_refs",
        "limitations",
        "verdict",
        "context_isolation",
        "context"
      ],
      "type": "object"
    }
  ],
  "title": "ReviewSubmit"
}
