{
  "$defs": {
    "ClientRef": {
      "additionalProperties": false,
      "description": "An alias of a record created by an earlier operation in this transaction.",
      "properties": {
        "client_ref": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "client_ref"
      ],
      "type": "object"
    },
    "Id": {
      "pattern": "^(case|q|src|art|obs|hyp|asm|opt|crit|cmp|assess|concl|dec|rev|obj|ann|retro|inq|run|tx|handle|checkpoint|import|ws)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/RevisionRef"
        },
        {
          "$ref": "#/$defs/ClientRef"
        }
      ]
    },
    "RevisionRef": {
      "additionalProperties": false,
      "description": "An exact revision already issued by the store.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    }
  },
  "$id": "urn:investigation:schema:v1:operation:hypothesis.create",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applicability": {
      "type": [
        "string",
        "null"
      ]
    },
    "assumption_refs": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "type": "array"
    },
    "possible_falsifiers": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "question_ref": {
      "$ref": "#/$defs/Reference"
    },
    "rival_refs": {
      "description": "Rival hypotheses on the same question, by exact revision or by the\nclient_ref of an earlier operation in this transaction; an alias of a\nlater operation is refused. A rivalry recorded once counts in both\ndirections, so rivals created together each name only those before\nthem.",
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "type": "array"
    },
    "statement": {
      "type": "string"
    }
  },
  "required": [
    "question_ref",
    "statement",
    "possible_falsifiers",
    "rival_refs",
    "assumption_refs"
  ],
  "title": "HypothesisCreate",
  "type": "object"
}
