{
  "$defs": {
    "ClientRef": {
      "additionalProperties": false,
      "description": "An alias of a record created by an earlier operation in this transaction.",
      "properties": {
        "client_ref": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "client_ref"
      ],
      "type": "object"
    },
    "CriterionKind": {
      "enum": [
        "hard",
        "soft"
      ],
      "type": "string"
    },
    "CriterionOverlapInput": {
      "additionalProperties": false,
      "description": "An investigator's declaration that a criterion overlaps or proxies another.",
      "properties": {
        "criterion_ref": {
          "$ref": "#/$defs/Reference"
        },
        "relation": {
          "$ref": "#/$defs/OverlapRelation"
        },
        "statement": {
          "type": "string"
        }
      },
      "required": [
        "criterion_ref",
        "relation",
        "statement"
      ],
      "type": "object"
    },
    "CriterionScale": {
      "additionalProperties": false,
      "properties": {
        "anchors": {
          "items": {
            "$ref": "#/$defs/ScaleAnchor"
          },
          "type": "array"
        },
        "description": {
          "type": "string"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "description",
        "anchors"
      ],
      "type": "object"
    },
    "CriterionScope": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "all_options",
              "type": "string"
            },
            "question_ref": {
              "$ref": "#/$defs/Reference"
            }
          },
          "required": [
            "kind",
            "question_ref"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "selected_options",
              "type": "string"
            },
            "option_refs": {
              "items": {
                "$ref": "#/$defs/Reference"
              },
              "type": "array"
            },
            "question_ref": {
              "$ref": "#/$defs/Reference"
            }
          },
          "required": [
            "kind",
            "question_ref",
            "option_refs"
          ],
          "type": "object"
        }
      ]
    },
    "CriterionWeightInput": {
      "additionalProperties": false,
      "description": "An optional weight on a soft criterion, supplied by people.",
      "properties": {
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/WeightRange"
            },
            {
              "type": "null"
            }
          ],
          "description": "Without a range the weight is stored as a stated preference and never\nenters a score."
        },
        "rationale": {
          "description": "Why this swing is worth this weight.",
          "type": "string"
        },
        "source_refs": {
          "description": "Where the preference was stated: Sources, Artifacts or Observations.",
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "type": "array"
        },
        "stated_by": {
          "description": "Whose preference this is, when not the recorder's.",
          "type": [
            "string",
            "null"
          ]
        },
        "uncertainty": {
          "anyOf": [
            {
              "$ref": "#/$defs/WeightUncertainty"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "$ref": "#/$defs/DecimalString",
          "description": "A positive weight for the swing from `range.worst` to `range.best`."
        }
      },
      "required": [
        "value",
        "rationale"
      ],
      "type": "object"
    },
    "DecimalString": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "type": "string"
    },
    "Id": {
      "pattern": "^(case|q|src|art|obs|hyp|asm|opt|crit|cmp|assess|concl|dec|rev|obj|ann|retro|inq|run|tx|handle|checkpoint|import|ws)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "decimal": {
          "$ref": "#/$defs/DecimalString"
        },
        "sample_count": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "statistic": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "decimal",
        "unit"
      ],
      "type": "object"
    },
    "OverlapRelation": {
      "oneOf": [
        {
          "const": "overlaps",
          "description": "Both criteria measure partly the same thing.",
          "type": "string"
        },
        {
          "const": "proxy_for",
          "description": "This criterion stands in for the other one.",
          "type": "string"
        }
      ]
    },
    "PreferredDirection": {
      "enum": [
        "higher",
        "lower",
        "target",
        "unordered"
      ],
      "type": "string"
    },
    "Reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/RevisionRef"
        },
        {
          "$ref": "#/$defs/ClientRef"
        }
      ]
    },
    "RevisionRef": {
      "additionalProperties": false,
      "description": "An exact revision already issued by the store.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    },
    "ScaleAnchor": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "meaning": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "meaning"
      ],
      "type": "object"
    },
    "Threshold": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "measured",
              "type": "string"
            },
            "operator": {
              "$ref": "#/$defs/ThresholdOperator"
            },
            "value": {
              "$ref": "#/$defs/Measurement"
            }
          },
          "required": [
            "kind",
            "operator",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "qualitative",
              "type": "string"
            },
            "requirement": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "requirement"
          ],
          "type": "object"
        }
      ]
    },
    "ThresholdOperator": {
      "enum": [
        "less_than",
        "at_most",
        "equal",
        "at_least",
        "greater_than"
      ],
      "type": "string"
    },
    "WeightRange": {
      "additionalProperties": false,
      "description": "The worst and best values a weight trades off, in the criterion's unit.",
      "properties": {
        "best": {
          "$ref": "#/$defs/DecimalString"
        },
        "worst": {
          "$ref": "#/$defs/DecimalString"
        }
      },
      "required": [
        "worst",
        "best"
      ],
      "type": "object"
    },
    "WeightUncertainty": {
      "additionalProperties": false,
      "description": "The stated uncertainty of a weight value; sensitivity varies the weight\nacross it.",
      "properties": {
        "high": {
          "$ref": "#/$defs/DecimalString"
        },
        "low": {
          "$ref": "#/$defs/DecimalString"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "type": "object"
    }
  },
  "$id": "urn:investigation:schema:v1:operation:criterion.create",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "$ref": "#/$defs/CriterionKind"
    },
    "name": {
      "type": "string"
    },
    "overlaps": {
      "description": "Criteria of the same question this one overlaps or stands in for.",
      "items": {
        "$ref": "#/$defs/CriterionOverlapInput"
      },
      "type": "array"
    },
    "preferred_direction": {
      "$ref": "#/$defs/PreferredDirection"
    },
    "scale": {
      "$ref": "#/$defs/CriterionScale"
    },
    "scope": {
      "$ref": "#/$defs/CriterionScope"
    },
    "threshold": {
      "anyOf": [
        {
          "$ref": "#/$defs/Threshold"
        },
        {
          "type": "null"
        }
      ]
    },
    "weight": {
      "anyOf": [
        {
          "$ref": "#/$defs/CriterionWeightInput"
        },
        {
          "type": "null"
        }
      ],
      "description": "An optional weight on a soft criterion. Without a range it is stored\nas a stated preference and never scored. See `weighting`."
    },
    "weighting_rationale": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "name",
    "kind",
    "scope",
    "scale",
    "preferred_direction"
  ],
  "title": "CriterionCreate",
  "type": "object"
}
