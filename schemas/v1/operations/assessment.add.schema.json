{
  "$defs": {
    "ActualInput": {
      "additionalProperties": false,
      "description": "One input the analysis actually read.",
      "properties": {
        "holdout": {
          "$ref": "#/$defs/HoldoutPlacement",
          "default": "not_declared",
          "description": "The investigator's declaration of this input relative to the reserved\nholdout. It is a claim; the core does not verify the boundary."
        },
        "input_ref": {
          "$ref": "#/$defs/Reference",
          "description": "An Observation, Artifact, Run or Source the analysis read."
        },
        "partition": {
          "description": "The observation unit or partition, as the holdout boundary names it.",
          "maxLength": 512,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "input_ref"
      ],
      "type": "object"
    },
    "AssessmentRelation": {
      "enum": [
        "supports",
        "contradicts",
        "non_diagnostic",
        "inconclusive"
      ],
      "type": "string"
    },
    "ClientRef": {
      "additionalProperties": false,
      "description": "An alias of a record created by an earlier operation in this transaction.",
      "properties": {
        "client_ref": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "client_ref"
      ],
      "type": "object"
    },
    "Confidence": {
      "additionalProperties": false,
      "properties": {
        "downgrade_reasons": {
          "anyOf": [
            {
              "$ref": "#/$defs/DowngradeReasons"
            },
            {
              "type": "null"
            }
          ]
        },
        "level": {
          "$ref": "#/$defs/ConfidenceLevel"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rationale": {
          "type": "string"
        },
        "what_would_change_it": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "level",
        "rationale",
        "limitations"
      ],
      "type": "object"
    },
    "ConfidenceLevel": {
      "enum": [
        "low",
        "moderate",
        "high",
        "not_assessed"
      ],
      "type": "string"
    },
    "Deviation": {
      "additionalProperties": false,
      "description": "One departure from the frozen plan.",
      "properties": {
        "description": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DeviationKind"
        },
        "reason": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "description",
        "reason"
      ],
      "type": "object"
    },
    "DeviationKind": {
      "description": "What kind of departure from the frozen plan a deviation is.",
      "oneOf": [
        {
          "enum": [
            "other"
          ],
          "type": "string"
        },
        {
          "const": "early_stop",
          "description": "Analysis stopped before the frozen stop rule was met.",
          "type": "string"
        },
        {
          "const": "late_stop",
          "description": "Collection or analysis continued past the frozen stop rule.",
          "type": "string"
        },
        {
          "const": "inputs_changed",
          "description": "Inputs differ from the frozen observation units or partitions.",
          "type": "string"
        },
        {
          "const": "exclusions_changed",
          "description": "Exclusions not foreseen by the frozen plan.",
          "type": "string"
        },
        {
          "const": "analysis_changed",
          "description": "The analysis differs from the frozen analysis rule.",
          "type": "string"
        },
        {
          "const": "controls_changed",
          "description": "Controls differ from the frozen control conditions.",
          "type": "string"
        }
      ]
    },
    "DowngradeJudgment": {
      "enum": [
        "ok",
        "concern",
        "not_assessed"
      ],
      "type": "string"
    },
    "DowngradeReasons": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "$ref": "#/$defs/DowngradeJudgment"
        },
        "consistency": {
          "$ref": "#/$defs/DowngradeJudgment"
        },
        "directness": {
          "$ref": "#/$defs/DowngradeJudgment"
        },
        "precision": {
          "$ref": "#/$defs/DowngradeJudgment"
        },
        "validity": {
          "$ref": "#/$defs/DowngradeJudgment"
        }
      },
      "required": [
        "validity",
        "consistency",
        "directness",
        "precision",
        "completeness"
      ],
      "type": "object"
    },
    "Exclusion": {
      "additionalProperties": false,
      "description": "One input or unit left out of the analysis.",
      "properties": {
        "excluded": {
          "description": "What was left out.",
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "input_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ],
          "description": "The excluded record, when it is recorded."
        },
        "reason": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "excluded",
        "reason"
      ],
      "type": "object"
    },
    "Expectation": {
      "enum": [
        "more_expected",
        "equally_expected",
        "less_expected",
        "not_assessed"
      ],
      "type": "string"
    },
    "FrozenBasis": {
      "additionalProperties": false,
      "description": "How an Assessment used a frozen confirmatory InquiryPlan: what it actually\nread, what it left out and how it differs from what was frozen.",
      "properties": {
        "actual_inputs": {
          "description": "Observation units or partitions actually analysed.",
          "items": {
            "$ref": "#/$defs/ActualInput"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        },
        "deviations": {
          "default": [],
          "description": "Every departure from the frozen plan, each with its reason. A\nfixed-sample analysis stopped after a favorable look is an `early_stop`.",
          "items": {
            "$ref": "#/$defs/Deviation"
          },
          "maxItems": 64,
          "type": "array"
        },
        "exclusions": {
          "default": [],
          "description": "Inputs or units left out of the analysis, each with its reason.",
          "items": {
            "$ref": "#/$defs/Exclusion"
          },
          "maxItems": 256,
          "type": "array"
        },
        "plan_ref": {
          "$ref": "#/$defs/Reference",
          "description": "Exact frozen confirmatory inquiry revision this assessment tests."
        },
        "stop_rule_applied": {
          "description": "The stop rule actually applied, in the investigator's words.",
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "plan_ref",
        "actual_inputs",
        "stop_rule_applied"
      ],
      "type": "object"
    },
    "HoldoutPlacement": {
      "description": "Where an input sits relative to the plan's reserved holdout.",
      "oneOf": [
        {
          "enum": [
            "not_declared"
          ],
          "type": "string"
        },
        {
          "const": "within_reserved",
          "description": "Inside the observation units or partitions the plan reserved.",
          "type": "string"
        },
        {
          "const": "outside_reserved",
          "description": "Outside them.",
          "type": "string"
        }
      ]
    },
    "Id": {
      "pattern": "^(case|q|src|art|obs|hyp|asm|opt|crit|cmp|assess|concl|dec|rev|obj|ann|retro|inq|run|tx|handle|checkpoint|import|ws)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Likelihood": {
      "additionalProperties": false,
      "properties": {
        "estimate": {
          "$ref": "#/$defs/LikelihoodEstimate"
        },
        "resolution_condition": {
          "$ref": "#/$defs/ResolutionCondition"
        }
      },
      "required": [
        "estimate",
        "resolution_condition"
      ],
      "type": "object"
    },
    "LikelihoodEstimate": {
      "anyOf": [
        {
          "$ref": "#/$defs/Probability"
        },
        {
          "$ref": "#/$defs/LikelihoodTerm"
        }
      ]
    },
    "LikelihoodTerm": {
      "description": "Ordinal labels from the first row of ICD 203 §D.6.e(2)(a).",
      "enum": [
        "almost_no_chance",
        "very_unlikely",
        "unlikely",
        "roughly_even_chance",
        "likely",
        "very_likely",
        "almost_certain"
      ],
      "type": "string"
    },
    "Probability": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "Reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/RevisionRef"
        },
        {
          "$ref": "#/$defs/ClientRef"
        }
      ]
    },
    "ResolutionCondition": {
      "pattern": "\\S",
      "type": "string"
    },
    "RevisionRef": {
      "additionalProperties": false,
      "description": "An exact revision already issued by the store.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    },
    "RivalExpectation": {
      "additionalProperties": false,
      "properties": {
        "expectation": {
          "$ref": "#/$defs/Expectation"
        },
        "rationale": {
          "type": "string"
        },
        "rival_ref": {
          "$ref": "#/$defs/Reference"
        }
      },
      "required": [
        "rival_ref",
        "expectation",
        "rationale"
      ],
      "type": "object"
    }
  },
  "$id": "urn:investigation:schema:v1:operation:assessment.add",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assumption_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "type": "array"
    },
    "confidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/Confidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "type": "array"
    },
    "frozen_basis": {
      "anyOf": [
        {
          "$ref": "#/$defs/FrozenBasis"
        },
        {
          "type": "null"
        }
      ],
      "description": "For an assessment of a frozen confirmatory InquiryPlan: the inputs\nactually read, exclusions, the stop rule applied and deviations from the\nfrozen plan. `show` reports the evidence-reuse reading beside the\nchronology of the Runs behind the inputs."
    },
    "likelihood": {
      "anyOf": [
        {
          "$ref": "#/$defs/Likelihood"
        },
        {
          "type": "null"
        }
      ]
    },
    "rationale": {
      "type": "string"
    },
    "relation": {
      "$ref": "#/$defs/AssessmentRelation"
    },
    "rival_expectations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RivalExpectation"
      },
      "type": "array"
    },
    "subject_ref": {
      "$ref": "#/$defs/Reference"
    }
  },
  "required": [
    "subject_ref",
    "evidence_refs",
    "relation",
    "rationale"
  ],
  "title": "AssessmentAdd",
  "type": "object"
}
