{
  "$defs": {
    "ClientRef": {
      "additionalProperties": false,
      "description": "An alias of a record created by an earlier operation in this transaction.",
      "properties": {
        "client_ref": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "client_ref"
      ],
      "type": "object"
    },
    "Id": {
      "pattern": "^(case|q|src|art|obs|hyp|asm|opt|crit|cmp|assess|concl|dec|rev|obj|ann|retro|inq|run|tx|handle|checkpoint|import|ws)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "OptionLifecycle": {
      "enum": [
        "proposed",
        "eligible",
        "ruled_out",
        "withdrawn",
        "superseded"
      ],
      "type": "string"
    },
    "Reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/RevisionRef"
        },
        {
          "$ref": "#/$defs/ClientRef"
        }
      ]
    },
    "RevisionRef": {
      "additionalProperties": false,
      "description": "An exact revision already issued by the store.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    }
  },
  "$id": "urn:investigation:schema:v1:operation:option.disposition",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "criterion_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reference"
        },
        {
          "type": "null"
        }
      ],
      "description": "Required when `lifecycle` is `ruled_out`: the active Criterion of the option's question\nthat rules it out. Otherwise optional."
    },
    "lifecycle": {
      "$ref": "#/$defs/OptionLifecycle",
      "description": "The new lifecycle. `proposed` is only the initial one."
    },
    "option_ref": {
      "$ref": "#/$defs/RevisionRef"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "option_ref",
    "lifecycle",
    "reason"
  ],
  "title": "OptionDispositionInput",
  "type": "object"
}
