{
  "$defs": {
    "ClientRef": {
      "additionalProperties": false,
      "description": "An alias of a record created by an earlier operation in this transaction.",
      "properties": {
        "client_ref": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "client_ref"
      ],
      "type": "object"
    },
    "Id": {
      "pattern": "^(case|q|src|art|obs|hyp|asm|opt|crit|cmp|assess|concl|dec|rev|obj|ann|retro|inq|run|tx|handle|checkpoint|import|ws)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Knowledge": {
      "description": "Explicit unknown is distinct from a known zero, empty string, or empty list.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "known",
              "type": "string"
            },
            "value": {
              "items": {
                "$ref": "#/$defs/Reference"
              },
              "type": "array"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "ObjectionSeverity": {
      "enum": [
        "critical",
        "material"
      ],
      "type": "string"
    },
    "Reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/RevisionRef"
        },
        {
          "$ref": "#/$defs/ClientRef"
        }
      ]
    },
    "RevisionRef": {
      "additionalProperties": false,
      "description": "An exact revision already issued by the store.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    }
  },
  "$id": "urn:investigation:schema:v1:operation:objection.raise",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence_refs": {
      "$ref": "#/$defs/Knowledge"
    },
    "review_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/ObjectionSeverity"
    },
    "statement": {
      "type": "string"
    },
    "subject_ref": {
      "$ref": "#/$defs/Reference"
    }
  },
  "required": [
    "subject_ref",
    "statement",
    "scope",
    "severity",
    "evidence_refs"
  ],
  "title": "ObjectionRaise",
  "type": "object"
}
