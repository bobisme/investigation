{
  "$defs": {
    "ClientRef": {
      "additionalProperties": false,
      "description": "An alias of a record created by an earlier operation in this transaction.",
      "properties": {
        "client_ref": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "client_ref"
      ],
      "type": "object"
    },
    "ConclusionStatus": {
      "enum": [
        "candidate",
        "review_ready",
        "validated",
        "rejected",
        "retracted",
        "superseded"
      ],
      "type": "string"
    },
    "Id": {
      "pattern": "^(case|q|src|art|obs|hyp|asm|opt|crit|cmp|assess|concl|dec|rev|obj|ann|retro|inq|run|tx|handle|checkpoint|import|ws)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/RevisionRef"
        },
        {
          "$ref": "#/$defs/ClientRef"
        }
      ]
    },
    "RevisionRef": {
      "additionalProperties": false,
      "description": "An exact revision already issued by the store.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    }
  },
  "$id": "urn:investigation:schema:v1:operation:conclusion.disposition",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "conclusion_ref": {
      "$ref": "#/$defs/RevisionRef"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "type": "array"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ConclusionStatus"
    },
    "successor_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reference"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "conclusion_ref",
    "status",
    "reason",
    "evidence_refs"
  ],
  "title": "ConclusionDisposition",
  "type": "object"
}
