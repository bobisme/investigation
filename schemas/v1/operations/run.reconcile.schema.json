        {
          "const": "all_attempts",
          "description": "Every started attempt, with unfinished or excluded attempts counted.",
          "type": "string"
        }
      ]
    },
    "TrialOrder": {
      "enum": [
        "interleaved",
        "randomized",
        "sequential"
      ],
      "type": "string"
    }
