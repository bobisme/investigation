        "kind": {
          "$ref": "#/$defs/StatisticKind"
        },
        "population": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge10"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which attempts the statistic is computed over."
        },
        "quantile": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecimalString"
            },
            {
              "type": "null"
            }
          ],
          "description": "Quantile level strictly between 0 and 1, such as `0.99`, with at most\nsix fractional digits. Required for a quantile and refused otherwise."
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "StatisticCombination": {
      "oneOf": [
        {
          "enum": [
            "other"
          ],
          "type": "string"
        },
        {
          "const": "single_run",
          "description": "Computed from one run.",
          "type": "string"
        },
        {
          "const": "pooled_samples",
          "description": "Computed from the raw samples of several runs together.",
          "type": "string"
        },
        {
          "const": "merged_histograms",
          "description": "Computed from mergeable histograms of several runs.",
          "type": "string"
        },
        {
          "const": "averaged_run_values",
          "description": "The mean of a value computed separately for each run.",
          "type": "string"
        }
      ]
    },
    "StatisticKind": {
      "enum": [
        "quantile",
        "mean",
        "minimum",
        "maximum",
        "other"
      ],
      "type": "string"
