      "properties": {
        "clock_quality": {
          "$ref": "#/$defs/ClockQuality"
        },
        "offset": {
          "$ref": "#/$defs/Knowledge"
        },
        "timestamp": {
          "$ref": "#/$defs/Knowledge"
        }
      },
      "required": [
        "timestamp",
        "offset",
        "clock_quality"
      ],
      "type": "object"
    },
    "Statistic": {
      "additionalProperties": false,
      "description": "The summary statistic a reported value states.",
      "properties": {
        "combination": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge11"
            },
            {
              "type": "null"
            }
