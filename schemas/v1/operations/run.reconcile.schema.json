        "empty_hits": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "examined_hits": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "exclusion_rules": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "filters": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "inclusion_rules": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "not_searched": {
          "description": "What was deliberately or necessarily not searched.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "queries": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
