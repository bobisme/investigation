{
  "$defs": {
    "AnnotationContent": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "text",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifact_ref": {
              "$ref": "#/$defs/Reference"
            },
            "digest": {
              "$ref": "#/$defs/Digest"
            },
            "kind": {
              "const": "artifact",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "artifact_ref",
            "digest"
          ],
          "type": "object"
        }
      ]
    },
    "AnnotationRole": {
      "enum": [
        "note",
        "synopsis",
        "advice_feedback"
      ],
      "type": "string"
    },
    "Classification": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/ClassificationLevel"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "level",
        "tags"
      ],
      "type": "object"
    },
    "ClassificationLevel": {
      "enum": [
        "public",
        "internal",
        "restricted"
      ],
      "type": "string"
    },
    "ClientRef": {
      "additionalProperties": false,
      "description": "An alias of a record created by an earlier operation in this transaction.",
      "properties": {
        "client_ref": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "client_ref"
      ],
      "type": "object"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "Id": {
      "pattern": "^(case|q|src|art|obs|hyp|asm|opt|crit|cmp|assess|concl|dec|rev|obj|ann|retro|inq|run|tx|handle|checkpoint|import|ws)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/RevisionRef"
        },
        {
          "$ref": "#/$defs/ClientRef"
        }
      ]
    },
    "RevisionRef": {
      "additionalProperties": false,
      "description": "An exact revision already issued by the store.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    }
  },
  "$id": "urn:investigation:schema:v1:operation:annotation.add",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "classification": {
      "$ref": "#/$defs/Classification",
      "default": {
        "level": "internal",
        "reason": null,
        "tags": []
      }
    },
    "content": {
      "$ref": "#/$defs/AnnotationContent"
    },
    "role": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnnotationRole"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject_refs": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "type": "array"
    }
  },
  "required": [
    "subject_refs",
    "content"
  ],
  "title": "AnnotationInput",
  "type": "object"
}
