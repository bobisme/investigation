{
  "$defs": {
    "AdviceDisposition": {
      "oneOf": [
        {
          "const": "defer",
          "description": "Stop ranking the suggestion until it changes materially or is resumed.",
          "type": "string"
        },
        {
          "const": "resume",
          "description": "End a recorded deferral now.",
          "type": "string"
        }
      ]
    },
    "AdviceFeedbackInput": {
      "additionalProperties": false,
      "description": "The `advice_feedback` object of `annotation.add` with\n`role: advice_feedback`. `subject_refs` are the gap's exact subject\nrevisions and `content` is the reason, as text.",
      "properties": {
        "disposition": {
          "$ref": "#/$defs/AdviceDisposition"
        },
        "revisit_condition": {
          "default": null,
          "description": "When the investigator means to look again. Recorded, never evaluated.",
          "type": [
            "string",
            "null"
          ]
        },
        "rule_id": {
          "description": "The gap rule ID that emits the suggestion, as `frontier` reports it.",
          "type": "string"
        },
        "rule_version": {
          "description": "The gap rule version that emitted it, as `frontier` reports it.",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "rule_version",
        "disposition"
      ],
      "type": "object"
    },
    "AnnotationContent": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "text",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifact_ref": {
              "$ref": "#/$defs/Reference"
            },
            "digest": {
              "$ref": "#/$defs/Digest"
            },
            "kind": {
              "const": "artifact",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "artifact_ref",
            "digest"
          ],
          "type": "object"
        }
      ]
    },
    "AnnotationRole": {
      "enum": [
        "note",
        "synopsis",
        "advice_feedback"
      ],
      "type": "string"
    },
    "Classification": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/ClassificationLevel"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "level",
        "tags"
      ],
      "type": "object"
    },
    "ClassificationLevel": {
      "enum": [
        "public",
        "internal",
        "restricted"
      ],
      "type": "string"
    },
    "ClientRef": {
      "additionalProperties": false,
      "description": "An alias of a record created by an earlier operation in this transaction.",
      "properties": {
        "client_ref": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "client_ref"
      ],
      "type": "object"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "HumanFileInput": {
      "additionalProperties": false,
      "description": "The `human_file` property of `annotation.add`: the person-owned vault\nfile whose bytes the annotation's artifact content captured.",
      "properties": {
        "path": {
          "description": "Vault-relative, `/`-separated, below `Notes/`, `Boards/` or `Inbox/`\n(inside the managed prefix in existing-vault mode), for example\n`Notes/plan.md`.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "Id": {
      "pattern": "^(case|q|src|art|obs|hyp|asm|opt|crit|cmp|assess|concl|dec|rev|obj|ann|retro|inq|run|tx|handle|checkpoint|import|ws)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/RevisionRef"
        },
        {
          "$ref": "#/$defs/ClientRef"
        }
      ]
    },
    "RevisionRef": {
      "additionalProperties": false,
      "description": "An exact revision already issued by the store.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    }
  },
  "$id": "urn:investigation:schema:v1:operation:annotation.add",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "advice_feedback": {
      "anyOf": [
        {
          "$ref": "#/$defs/AdviceFeedbackInput"
        },
        {
          "type": "null"
        }
      ],
      "description": "Required with `role: advice_feedback`, and only with it."
    },
    "classification": {
      "$ref": "#/$defs/Classification",
      "default": {
        "level": "internal",
        "reason": null,
        "tags": []
      }
    },
    "content": {
      "$ref": "#/$defs/AnnotationContent"
    },
    "human_file": {
      "anyOf": [
        {
          "$ref": "#/$defs/HumanFileInput"
        },
        {
          "type": "null"
        }
      ],
      "description": "The person-owned vault file whose exact bytes the artifact content\ncaptured (a note snapshot). Only with artifact content and role\n`note`. `investigation vault snapshot-note` writes it."
    },
    "role": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnnotationRole"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject_refs": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "type": "array"
    }
  },
  "required": [
    "subject_refs",
    "content"
  ],
  "title": "AnnotationInput",
  "type": "object"
}
