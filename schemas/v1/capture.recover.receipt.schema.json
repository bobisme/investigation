{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Durable receipt for an accepted artifact descriptor.",
      "properties": {
        "availability": {
          "$ref": "#/$defs/StagedAvailability",
          "description": "Staged or missing."
        },
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "description": "Digest of the retained bytes, when staged."
        },
        "receipt": {
          "$ref": "#/$defs/ItemReceipt",
          "description": "Item receipt at the artifact's position."
        },
        "role": {
          "$ref": "#/$defs/ArtifactRole",
          "description": "Accepted role."
        },
        "size_bytes": {
          "description": "Size of the retained bytes, when staged.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "receipt",
        "role",
        "availability"
      ],
      "type": "object"
    },
    "ArtifactRole": {
      "description": "Role of an artifact within the Run.",
      "oneOf": [
        {
          "const": "original-output",
          "description": "Original output of the external action.",
          "type": "string"
        },
        {
          "const": "derivative",
          "description": "Derived from another item; set [`StableArtifact::derived_from`].",
          "type": "string"
        },
        {
          "const": "log",
          "description": "A log of the producer or the action.",
          "type": "string"
        },
        {
          "const": "receipt",
          "description": "An external receipt, such as a signed execution statement.",
          "type": "string"
        }
      ]
    },
    "CaptureHandle": {
      "pattern": "^handle_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "CommitResult": {
      "enum": [
        "committed",
        "already_committed"
      ],
      "type": "string"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "ExecutionStatus": {
      "enum": [
        "declared",
        "running",
        "completed",
        "failed",
        "cancelled",
        "blocked",
        "unknown"
      ],
      "type": "string"
    },
    "ExternalRunId": {
      "description": "1 to 256 characters without control characters",
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "Finalization": {
      "description": "Finalization status, independent of execution success.",
      "oneOf": [
        {
          "const": "finalized",
          "description": "Every claimed item is present.",
          "type": "string"
        },
        {
          "const": "finalized_partial",
          "description": "Finalized with known gaps; see [`FinalizeReceipt::missing_positions`].",
          "type": "string"
        }
      ]
    },
    "FinalizeReceipt": {
      "additionalProperties": false,
      "description": "Durable receipt for a sealed capture.",
      "properties": {
        "case_id": {
          "$ref": "#/$defs/Id",
          "description": "The case holding the Run."
        },
        "commit": {
          "$ref": "#/$defs/Receipt",
          "description": "Journal receipt of the finalizing transaction."
        },
        "execution": {
          "$ref": "#/$defs/ExecutionStatus",
          "description": "Execution state as recorded. `completed` here does not mean `finalized`,\nand `failed` does not prevent finalization."
        },
        "finalization": {
          "$ref": "#/$defs/Finalization",
          "description": "Finalization status."
        },
        "handle": {
          "$ref": "#/$defs/CaptureHandle",
          "description": "Sealed handle."
        },
        "manifest_digest": {
          "$ref": "#/$defs/Digest",
          "description": "Digest of the immutable manifest artifact."
        },
        "missing_positions": {
          "description": "Positions known to be missing.",
          "items": {
            "$ref": "#/$defs/Position"
          },
          "type": "array"
        },
        "run_id": {
          "$ref": "#/$defs/Id",
          "description": "The Run."
        },
        "sealed_position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ],
          "description": "Last accepted position when the handle was sealed."
        }
      },
      "required": [
        "handle",
        "run_id",
        "case_id",
        "finalization",
        "execution",
        "manifest_digest",
        "commit"
      ],
      "type": "object"
    },
    "Guidance": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/GuidanceKind"
        }
      },
      "required": [
        "kind",
        "argv"
      ],
      "type": "object"
    },
    "GuidanceKind": {
      "enum": [
        "local_read"
      ],
      "type": "string"
    },
    "HandleRecovery": {
      "additionalProperties": false,
      "description": "What one handle accepted.",
      "properties": {
        "artifacts": {
          "description": "Receipts of accepted artifacts, in position order.",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": "array"
        },
        "case_id": {
          "$ref": "#/$defs/Id",
          "description": "The case holding the Run."
        },
        "execution": {
          "$ref": "#/$defs/ExecutionStatus",
          "default": "unknown",
          "description": "The external execution state as recorded: `unknown` until a finalize\ncommits the producer's report. Recovery never infers it."
        },
        "external_run_id": {
          "$ref": "#/$defs/ExternalRunId",
          "description": "External run ID from `begin`."
        },
        "finalized": {
          "anyOf": [
            {
              "$ref": "#/$defs/FinalizeReceipt"
            },
            {
              "type": "null"
            }
          ],
          "description": "The finalize receipt, once finalized."
        },
        "handle": {
          "$ref": "#/$defs/CaptureHandle",
          "description": "The handle."
        },
        "items": {
          "description": "Receipts of accepted facts, in position order.",
          "items": {
            "$ref": "#/$defs/ItemReceipt"
          },
          "type": "array"
        },
        "last_position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ],
          "description": "Last accepted position; the next item takes the following one."
        },
        "next": {
          "description": "The calls that continue or settle this recording.",
          "items": {
            "$ref": "#/$defs/RecoveryStep"
          },
          "type": "array"
        },
        "next_position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ],
          "description": "The position the next item must take, while the handle is open."
        },
        "producer": {
          "$ref": "#/$defs/ProducerIdentity",
          "description": "Producer identity from `begin`."
        },
        "run_id": {
          "$ref": "#/$defs/Id",
          "description": "The Run it declared."
        },
        "seal": {
          "$ref": "#/$defs/SealState",
          "description": "Seal state."
        },
        "staging": {
          "anyOf": [
            {
              "$ref": "#/$defs/StagingState"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the staging directory holds."
        },
        "staging_dir": {
          "description": "Staging directory, until it is retired after finalization.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "handle",
        "run_id",
        "case_id",
        "producer",
        "external_run_id",
        "seal",
        "items",
        "artifacts"
      ],
      "type": "object"
    },
    "Id": {
      "pattern": "^(case|q|src|art|obs|hyp|asm|opt|crit|cmp|assess|concl|dec|rev|obj|ann|retro|inq|run|tx|handle|checkpoint|import|ws)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "IdempotencyKey": {
      "description": "1 to 128 characters without control characters",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "ItemReceipt": {
      "additionalProperties": false,
      "description": "Durable receipt for one accepted item on a handle.\n\nThe recorder persists the item, this receipt and the handle cursor before\nreturning it.",
      "properties": {
        "accepted_at": {
          "$ref": "#/$defs/UtcTimestamp",
          "description": "Local acceptance time, distinct from any producer-reported time."
        },
        "handle": {
          "$ref": "#/$defs/CaptureHandle",
          "description": "Handle holding the item."
        },
        "key": {
          "$ref": "#/$defs/IdempotencyKey",
          "description": "Producer item key."
        },
        "position": {
          "$ref": "#/$defs/Position",
          "description": "Accepted position."
        },
        "request_digest": {
          "$ref": "#/$defs/Digest",
          "description": "Digest of the parsed request, used to detect conflicting retries."
        },
        "result": {
          "$ref": "#/$defs/ReceiptResult",
          "description": "First acceptance or replay."
        },
        "run_id": {
          "$ref": "#/$defs/Id",
          "description": "Run declared by the handle."
        }
      },
      "required": [
        "result",
        "handle",
        "run_id",
        "position",
        "key",
        "request_digest",
        "accepted_at"
      ],
      "type": "object"
    },
    "Position": {
      "description": "One-based position of an accepted item within a capture handle.\n\nAppended facts and attachment descriptors share one sequence. The recorder\naccepts only the next expected position, so a lost middle item is detectable.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "ProducerIdentity": {
      "additionalProperties": false,
      "description": "Self-reported producer identity. It is attribution, not authentication.",
      "properties": {
        "instance": {
          "description": "Producer instance, such as a host-local label, when reported.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "$ref": "#/$defs/ProducerName",
          "description": "Producer namespace."
        },
        "version": {
          "description": "Producer version, when the producer reports one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ProducerName": {
      "description": "1–128 ASCII letters, digits, '.', '_' or '-', starting with a letter or digit",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "Projection": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "$ref": "#/$defs/ProjectionStatus"
        },
        "vault": {
          "$ref": "#/$defs/ProjectionStatus"
        }
      },
      "required": [
        "index",
        "vault"
      ],
      "type": "object"
    },
    "ProjectionStatus": {
      "enum": [
        "current",
        "pending",
        "degraded",
        "disabled"
      ],
      "type": "string"
    },
    "Receipt": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ReceiptArtifact"
          },
          "type": "array"
        },
        "command_id": {
          "type": "string"
        },
        "created": {
          "items": {
            "$ref": "#/$defs/RecordChange"
          },
          "type": "array"
        },
        "next": {
          "items": {
            "$ref": "#/$defs/Guidance"
          },
          "type": "array"
        },
        "observation_checks": {
          "items": {
            "$ref": "#/$defs/ReceiptObservation"
          },
          "type": "array"
        },
        "ok": {
          "type": "boolean"
        },
        "projection": {
          "$ref": "#/$defs/Projection"
        },
        "result": {
          "$ref": "#/$defs/CommitResult"
        },
        "schema_version": {
          "$ref": "#/$defs/ResponseVersion"
        },
        "snapshot": {
          "$ref": "#/$defs/Snapshot"
        },
        "transaction_id": {
          "$ref": "#/$defs/Id"
        },
        "updated": {
          "items": {
            "$ref": "#/$defs/RecordChange"
          },
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "ok",
        "result",
        "command_id",
        "transaction_id",
        "snapshot",
        "created",
        "updated",
        "projection",
        "warnings",
        "next"
      ],
      "type": "object"
    },
    "ReceiptArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/RevisionRef"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "artifact",
        "digest",
        "size_bytes"
      ],
      "type": "object"
    },
    "ReceiptObservation": {
      "additionalProperties": false,
      "properties": {
        "observation": {
          "$ref": "#/$defs/RevisionRef"
        },
        "quote_state": {
          "$ref": "#/$defs/TextQuoteState"
        },
        "selector_validation": {
          "$ref": "#/$defs/SelectorValidation"
        }
      },
      "required": [
        "observation",
        "selector_validation",
        "quote_state"
      ],
      "type": "object"
    },
    "ReceiptResult": {
      "description": "Whether a receipt reports a first acceptance or a replay of an earlier one.",
      "oneOf": [
        {
          "const": "accepted",
          "description": "This call made the item durable.",
          "type": "string"
        },
        {
          "const": "already_accepted",
          "description": "An identical earlier call made it durable; this is that call's receipt.",
          "type": "string"
        }
      ]
    },
    "RecordChange": {
      "additionalProperties": false,
      "properties": {
        "client_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    },
    "RecoveryAction": {
      "description": "A capture call that continues or settles a recording.",
      "oneOf": [
        {
          "const": "resend_begin",
          "description": "Resend the identical `begin` request under `key`.",
          "type": "string"
        },
        {
          "const": "append",
          "description": "Record the next fact at `next_position`.",
          "type": "string"
        },
        {
          "const": "attach",
          "description": "Record the next artifact at `next_position`.",
          "type": "string"
        },
        {
          "const": "finalize",
          "description": "Settle the handle. A producer that cannot vouch for every step finalizes\nwith completion `interrupted` and execution state `unknown`.",
          "type": "string"
        },
        {
          "const": "resend_finalize",
          "description": "Resend the identical sealing `finalize` request under `key`; only the\nrequest with `request_digest` completes the handle.",
          "type": "string"
        },
        {
          "const": "lookup_receipt",
          "description": "Read the committed finalize receipt under `key`.",
          "type": "string"
        }
      ]
    },
    "RecoveryStep": {
      "additionalProperties": false,
      "description": "One next step for a handle and the exact command that takes it.\n\nEvery step records, reads or retries a recording call. None reruns or\nresumes the producer's external action; whether that action happened is the\nproducer's knowledge, not the recorder's.",
      "properties": {
        "action": {
          "$ref": "#/$defs/RecoveryAction",
          "description": "What the step does."
        },
        "argv": {
          "description": "The command, as an argument array. A request is read from stdin.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "key": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdempotencyKey"
            },
            {
              "type": "null"
            }
          ],
          "description": "The key the request must carry, when only one key fits."
        },
        "request_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "description": "Digest of the only request that fits, when the handle is sealed."
        }
      },
      "required": [
        "action",
        "argv"
      ],
      "type": "object"
    },
    "ResponseVersion": {
      "enum": [
        "inv.response.v1"
      ],
      "type": "string"
    },
    "RevisionRef": {
      "additionalProperties": false,
      "description": "An exact revision already issued by the store.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    },
    "SealState": {
      "description": "Seal state of a handle.",
      "oneOf": [
        {
          "const": "open",
          "description": "Accepting items.",
          "type": "string"
        },
        {
          "const": "sealed",
          "description": "Sealed; the manifest is not yet published.",
          "type": "string"
        },
        {
          "const": "finalized",
          "description": "The manifest is published.",
          "type": "string"
        }
      ]
    },
    "SelectorValidation": {
      "enum": [
        "unverified",
        "verified",
        "ambiguous",
        "not_found",
        "unavailable"
      ],
      "type": "string"
    },
    "Snapshot": {
      "additionalProperties": false,
      "properties": {
        "head_hash": {
          "$ref": "#/$defs/Digest"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "head_hash"
      ],
      "type": "object"
    },
    "StagedAvailability": {
      "description": "Whether staged bytes exist for an accepted artifact.",
      "oneOf": [
        {
          "const": "staged",
          "description": "The verified bytes are durable in staging.",
          "type": "string"
        },
        {
          "const": "missing",
          "description": "The artifact is recorded as missing.",
          "type": "string"
        }
      ]
    },
    "StagingState": {
      "description": "What a handle's staging directory holds.",
      "oneOf": [
        {
          "const": "present",
          "description": "Staging holds the accepted items and their bytes.",
          "type": "string"
        },
        {
          "const": "unallocated",
          "description": "The Run is declared but a crash left its staging unallocated. Resend the\nidentical `begin` request to allocate it.",
          "type": "string"
        },
        {
          "const": "retired",
          "description": "The handle is finalized and its staging is gone. The manifest Artifact\nholds every accepted item.",
          "type": "string"
        }
      ]
    },
    "TextQuoteState": {
      "enum": [
        "unverified",
        "verified",
        "ambiguous",
        "not_found",
        "unavailable",
        "not_applicable"
      ],
      "type": "string"
    },
    "UtcTimestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{1,9}Z$",
      "type": "string"
    }
  },
  "$id": "urn:investigation:schema:v1:wire:capture.recover.receipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Accepted state of the requested handles.",
  "properties": {
    "handles": {
      "description": "One entry per reported handle.",
      "items": {
        "$ref": "#/$defs/HandleRecovery"
      },
      "type": "array"
    }
  },
  "required": [
    "handles"
  ],
  "title": "RecoveryState",
  "type": "object"
}
