{
  "$defs": {
    "Actor": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:_.-]+$",
      "type": "string"
    },
    "ActorDescriptor": {
      "additionalProperties": false,
      "description": "Every field is self-reported, including kind; it is not an authentication claim.",
      "properties": {
        "harness": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "model_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ActorKind": {
      "enum": [
        "human",
        "agent"
      ],
      "type": "string"
    },
    "CommandVersion": {
      "enum": [
        "inv.command.v1"
      ],
      "type": "string"
    },
    "ConfirmedWrite": {
      "additionalProperties": false,
      "description": "One guarded write a human confirmation covers.",
      "properties": {
        "op": {
          "$ref": "#/$defs/GuardedOperation"
        },
        "subject": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "op",
        "subject"
      ],
      "type": "object"
    },
    "GuardedOperation": {
      "description": "The closed set of operations a guardrail can guard.",
      "enum": [
        "conclusion.validate",
        "decision.accept",
        "source.withdraw",
        "artifact.withdraw",
        "artifact.expire",
        "observation.retract",
        "classification.downgrade"
      ],
      "type": "string"
    },
    "HumanConfirmation": {
      "additionalProperties": false,
      "description": "An attributed claim, carried in the command envelope, that a person\nconfirmed specific guarded writes. Investigation records it as stated and\ndoes not authenticate the person or the method.",
      "properties": {
        "confirmed_by": {
          "$ref": "#/$defs/Actor",
          "description": "Who confirmed, as an actor string. Self-reported, not authenticated."
        },
        "confirms": {
          "description": "The guarded writes confirmed: each names the operation and the ID of\nthe record it changes (the Conclusion, Decision, Source, Observation,\nor the record being downgraded).",
          "items": {
            "$ref": "#/$defs/ConfirmedWrite"
          },
          "maxItems": 128,
          "minItems": 1,
          "type": "array"
        },
        "method": {
          "description": "How the confirmation was obtained, in words. Self-reported.",
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "confirmed_by",
        "method",
        "confirms"
      ],
      "type": "object"
    },
    "Id": {
      "pattern": "^(case|q|src|art|obs|hyp|asm|opt|crit|cmp|assess|concl|dec|rev|obj|ann|retro|inq|run|tx|handle|checkpoint|import|ws)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Operation": {
      "additionalProperties": false,
      "properties": {
        "client_ref": {
          "maxLength": 128,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "extensions": {
          "additionalProperties": true,
          "description": "Optional fields declared by method packs the case has adopted, keyed\nby pack ID: `{\"<pack id>\": {\"<property>\": value}}`. They are stored on\nthe record this operation creates, or on the single record it revises,\nafter a check against the pinned pack's property schemas. An object\nreplaces that pack's fields on the record; `null` removes them. The\ncore never interprets them.",
          "type": [
            "object",
            "null"
          ]
        },
        "op": {
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "op",
        "payload"
      ],
      "type": "object"
    },
    "RevisionRef": {
      "additionalProperties": false,
      "description": "An exact revision already issued by the store.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    },
    "Session": {
      "description": "Self-reported session label. Evidence reads made through investigation by the same actor under this label before the commit are recorded on the transaction for inherited trust.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:_.-]+$",
      "type": "string"
    }
  },
  "$id": "urn:investigation:schema:v1:wire:record",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "actor_descriptor": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActorDescriptor"
        },
        {
          "type": "null"
        }
      ]
    },
    "case_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Id"
        },
        {
          "type": "null"
        }
      ]
    },
    "command_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "human_confirmation": {
      "anyOf": [
        {
          "$ref": "#/$defs/HumanConfirmation"
        },
        {
          "type": "null"
        }
      ],
      "description": "An attributed claim that a person confirmed named guarded writes, for\na pinned pack guardrail that requires one. Recorded as stated;\ninvestigation does not authenticate people."
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/Operation"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "preconditions": {
      "items": {
        "$ref": "#/$defs/RevisionRef"
      },
      "type": "array"
    },
    "schema_version": {
      "$ref": "#/$defs/CommandVersion"
    },
    "session": {
      "anyOf": [
        {
          "$ref": "#/$defs/Session"
        },
        {
          "type": "null"
        }
      ],
      "description": "Self-reported session. At commit the store records on the transaction\nthe evidence reads this actor made through investigation under it, for\nthe inherited trust of authored text. Absent means unknown."
    }
  },
  "required": [
    "schema_version",
    "command_id",
    "actor",
    "preconditions",
    "operations"
  ],
  "title": "Command",
  "type": "object"
}
