{
  "$defs": {
    "AcquisitionKeyRequest": {
      "additionalProperties": false,
      "description": "Producer namespace plus stable external ID of one logical acquisition attempt.\nReimporting the same attempt maps onto the recorded Source; a changed\ndescription of it records a revision, not a new acquisition. Each path or\nstdin name identifies one item within the attempt.",
      "properties": {
        "external_id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "namespace": {
          "description": "A producer name, under the same rule as a capture producer name and an\nenvelope's `producer.name`.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "external_id"
      ],
      "type": "object"
    },
    "Actor": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:_.-]+$",
      "type": "string"
    },
    "ActorDescriptor": {
      "additionalProperties": false,
      "description": "Every field is self-reported, including kind; it is not an authentication claim.",
      "properties": {
        "harness": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "model_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ActorKind": {
      "enum": [
        "human",
        "agent"
      ],
      "type": "string"
    },
    "CaseCreate": {
      "additionalProperties": false,
      "description": "Payload for `case.create`; the engine assigns a durable case ID.",
      "properties": {
        "decision_relevance": {
          "type": [
            "string",
            "null"
          ]
        },
        "exclusions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expectations": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaseExpectations"
            },
            {
              "type": "null"
            }
          ]
        },
        "method_pins": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mode": {
          "$ref": "#/$defs/CaseMode",
          "default": "explore"
        },
        "objective": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy_pins": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge"
            },
            {
              "type": "null"
            }
          ]
        },
        "stop_condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge2"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "CaseExpectations": {
      "additionalProperties": false,
      "properties": {
        "expected_answer_or_choice": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "surprising_outcomes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "surprising_outcomes"
      ],
      "type": "object"
    },
    "CaseMode": {
      "enum": [
        "explain",
        "measure",
        "evaluate",
        "explore",
        "record"
      ],
      "type": "string"
    },
    "ClassificationLevel": {
      "enum": [
        "public",
        "internal",
        "restricted"
      ],
      "type": "string"
    },
    "DecimalString": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "type": "string"
    },
    "DerivationInputRequest": {
      "additionalProperties": false,
      "description": "One exact Artifact revision the transformation read.",
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/RevisionRef"
        },
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "description": "Digest of the bytes the transformation read. When supplied it must match\nthe input's recorded digest; the recorded digest is what is stored."
        }
      },
      "required": [
        "artifact_ref"
      ],
      "type": "object"
    },
    "DerivationReview": {
      "additionalProperties": false,
      "description": "How the output of a derivation was reviewed. Absent means not reviewed.\nA review never lowers classification by itself; that needs a reviewed\n`classification.downgrade` of the derivative.",
      "properties": {
        "coverage": {
          "$ref": "#/$defs/ReviewCoverage"
        },
        "limitations": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "type": "array"
        },
        "method": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "method",
        "coverage"
      ],
      "type": "object"
    },
    "DerivedFromRequest": {
      "additionalProperties": false,
      "description": "The ingested bytes are the output of a transformation of recorded Artifacts.\nThe output is recorded as a derivative of those inputs, never as a new\nacquisition. Requires an existing `case_id`; the inputs must be in that case.",
      "properties": {
        "inputs": {
          "description": "Direct inputs; the first is the primary input whose acquisition the\nderivative's `source` names.",
          "items": {
            "$ref": "#/$defs/DerivationInputRequest"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "redaction_decisions": {
          "items": {
            "$ref": "#/$defs/RedactionDecision"
          },
          "maxItems": 256,
          "type": "array"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/DerivationReview"
            },
            {
              "type": "null"
            }
          ],
          "description": "How the output was reviewed. Omit it when nobody reviewed the output.\nA review never lowers classification; use `classification.downgrade`."
        },
        "selectors": {
          "description": "Portions of the inputs the transformation used.",
          "items": {
            "$ref": "#/$defs/SelectorRequest"
          },
          "maxItems": 64,
          "type": "array"
        },
        "transformation": {
          "description": "Transformation identity, such as `example-org.redact`.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "inputs",
        "transformation",
        "version"
      ],
      "type": "object"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "ExternalRefRequest": {
      "additionalProperties": false,
      "description": "Bytes held at an external location that this ingest does not supply. The\nexpected digest and size are recorded as declared; the Artifact stays\n`external` and unverified until supplied bytes match (`reverify`).",
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "locator": {
          "description": "Opaque locator. It is recorded as text and never fetched.",
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "locator",
        "digest",
        "size_bytes"
      ],
      "type": "object"
    },
    "Id": {
      "pattern": "^(case|q|src|art|obs|hyp|asm|opt|crit|cmp|assess|concl|dec|rev|obj|ann|retro|inq|run|tx|handle|checkpoint|import|ws)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "IngestVersion": {
      "enum": [
        "inv.ingest.v1"
      ],
      "type": "string"
    },
    "Knowledge": {
      "description": "Explicit unknown is distinct from a known zero, empty string, or empty list.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "known",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "Knowledge2": {
      "description": "Explicit unknown is distinct from a known zero, empty string, or empty list.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "known",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/StopCondition"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "RedactionAction": {
      "oneOf": [
        {
          "enum": [
            "removed",
            "masked",
            "generalized"
          ],
          "type": "string"
        },
        {
          "const": "retained",
          "description": "Kept unchanged after review; the rationale says why it is safe.",
          "type": "string"
        }
      ]
    },
    "RedactionDecision": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/RedactionAction"
        },
        "rationale": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "scope": {
          "description": "What the decision covers, e.g. a field, region or kind of content.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "scope",
        "action",
        "rationale"
      ],
      "type": "object"
    },
    "RetentionMode": {
      "description": "How local `paths` are kept. `copy` (the default) snapshots the bytes into\nthe workspace. `reference` hashes them without copying: the Artifact is\n`external` and cannot satisfy an offline-completeness guarantee.",
      "enum": [
        "copy",
        "reference"
      ],
      "type": "string"
    },
    "ReverifyRequest": {
      "additionalProperties": false,
      "description": "Compare the supplied bytes (one path or stdin) with an exact reference-only\nArtifact revision. Requires `case_id`; creates no Source.",
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/RevisionRef"
        }
      },
      "required": [
        "artifact_ref"
      ],
      "type": "object"
    },
    "ReviewCoverage": {
      "description": "How thoroughly the reviewer examined the transformed output.",
      "oneOf": [
        {
          "const": "whole_output",
          "description": "The reviewer examined the whole transformed output.",
          "type": "string"
        },
        {
          "const": "pattern_matching_only",
          "description": "Only automated pattern matching ran. Never sufficient for a downgrade;\nlisted so producers can report it honestly and receive a repair.",
          "type": "string"
        }
      ]
    },
    "RevisionRef": {
      "additionalProperties": false,
      "description": "An exact revision already issued by the store.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    },
    "SelectorKind": {
      "description": "The actual discriminated union. `EvidenceSelector` binds this to a digest\nand a core-computed validation result.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "whole",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "end": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "start": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "byte_range",
              "type": "string"
            }
          },
          "required": [
            "type",
            "start",
            "end"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "encoding": {
              "type": "string"
            },
            "end_line": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "parser_version": {
              "type": "string"
            },
            "start_line": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "text_lines",
              "type": "string"
            }
          },
          "required": [
            "type",
            "start_line",
            "end_line",
            "encoding",
            "parser_version"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "exact": {
              "type": "string"
            },
            "prefix": {
              "type": [
                "string",
                "null"
              ]
            },
            "suffix": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "text_quote",
              "type": "string"
            }
          },
          "required": [
            "type",
            "exact"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "parser": {
              "type": [
                "string",
                "null"
              ]
            },
            "pointer": {
              "type": "string"
            },
            "type": {
              "const": "json_pointer",
              "type": "string"
            }
          },
          "required": [
            "type",
            "pointer"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A cell of a named table. `extraction_version` names the reader that\nproduced the table; the core resolves only its own declared delimited\nreaders, `inv.table.csv.v1` and `inv.table.tsv.v1`, and never guesses a\ndelimiter. `row_index` is zero-based over data rows after the header row;\n`row_identity` is the exact value of `key_column` in the selected row.",
          "properties": {
            "column": {
              "type": "string"
            },
            "extraction_version": {
              "type": "string"
            },
            "key_column": {
              "description": "Header of the column that holds `row_identity`. Without it a\n`row_identity` cannot be checked and the selector stays `unavailable`.",
              "type": [
                "string",
                "null"
              ]
            },
            "row_identity": {
              "type": [
                "string",
                "null"
              ]
            },
            "row_index": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "table": {
              "type": "string"
            },
            "type": {
              "const": "table_cell",
              "type": "string"
            }
          },
          "required": [
            "type",
            "table",
            "column",
            "extraction_version"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "channel": {
              "type": "string"
            },
            "coordinate_origin": {
              "type": "string"
            },
            "end": {
              "$ref": "#/$defs/DecimalString"
            },
            "start": {
              "$ref": "#/$defs/DecimalString"
            },
            "type": {
              "const": "time_window",
              "type": "string"
            },
            "unit": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "start",
            "end",
            "unit",
            "coordinate_origin",
            "channel"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "blob_digest": {
              "$ref": "#/$defs/Digest"
            },
            "commit": {
              "type": "string"
            },
            "end_line": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "path": {
              "type": "string"
            },
            "repository": {
              "type": "string"
            },
            "start_line": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "code_span",
              "type": "string"
            }
          },
          "required": [
            "type",
            "repository",
            "commit",
            "blob_digest",
            "path",
            "start_line",
            "end_line"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "type": "string"
            },
            "schema_uri": {
              "type": "string"
            },
            "schema_version": {
              "type": "string"
            },
            "type": {
              "const": "external_selector",
              "type": "string"
            },
            "validator": {
              "type": [
                "string",
                "null"
              ]
            },
            "value": true
          },
          "required": [
            "type",
            "namespace",
            "schema_uri",
            "schema_version",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "SelectorRequest": {
      "additionalProperties": false,
      "description": "Request form deliberately lacks a validation field.",
      "properties": {
        "artifact_digest": {
          "$ref": "#/$defs/Digest"
        },
        "schema_version": {
          "$ref": "#/$defs/SelectorVersion"
        },
        "selector": {
          "$ref": "#/$defs/SelectorKind"
        }
      },
      "required": [
        "schema_version",
        "artifact_digest",
        "selector"
      ],
      "type": "object"
    },
    "SelectorVersion": {
      "description": "The selector schema is versioned independently from record and command schemas.",
      "enum": [
        "inv.selector.v1"
      ],
      "type": "string"
    },
    "SourceManifest": {
      "additionalProperties": false,
      "properties": {
        "acquisition_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcquisitionKeyRequest"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stable identity of the logical acquisition. Without it every ingest is\na separate acquisition, even when its bytes match an earlier one."
        },
        "context": {
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Opaque producer metadata retained with the resulting Source.",
          "type": "object"
        },
        "producer": {
          "type": [
            "string",
            "null"
          ]
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "verification_limits": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "StopCondition": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/StopReason"
          },
          "type": "array"
        },
        "reopening_conditions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "residual_risks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "description",
        "reasons",
        "residual_risks",
        "reopening_conditions"
      ],
      "type": "object"
    },
    "StopReason": {
      "enum": [
        "question_answered",
        "choice_made",
        "conditional_decision_accepted",
        "uncertainty_tolerated",
        "insufficient_evidence",
        "prerequisite_unavailable",
        "cost_or_time_exhausted",
        "experiment_too_disruptive",
        "experiment_not_authorized",
        "volatile_evidence_preserved",
        "superseded_question",
        "investigator_pause"
      ],
      "type": "string"
    },
    "StreamContent": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "stdin",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "urn:investigation:schema:v1:wire:ingest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "actor_descriptor": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActorDescriptor"
        },
        {
          "type": "null"
        }
      ]
    },
    "case_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Id"
        },
        {
          "type": "null"
        }
      ]
    },
    "classification": {
      "$ref": "#/$defs/ClassificationLevel",
      "default": "internal"
    },
    "command_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "content": {
      "anyOf": [
        {
          "$ref": "#/$defs/StreamContent"
        },
        {
          "type": "null"
        }
      ]
    },
    "derived_from": {
      "anyOf": [
        {
          "$ref": "#/$defs/DerivedFromRequest"
        },
        {
          "type": "null"
        }
      ],
      "description": "The items are outputs of a transformation of recorded Artifacts. They are\nrecorded as derivatives of those inputs: no Source or acquisition is\ncreated, `source.title` labels the output and `source.format` gives its\nformat."
    },
    "external_refs": {
      "description": "Reference-only items: bytes held at an external location, named by an\nopaque locator with their expected digest and size. Nothing is read or\ncopied; each Artifact is `external` and unverified until `reverify`.\nExclusive with `paths` and `content`.",
      "items": {
        "$ref": "#/$defs/ExternalRefRequest"
      },
      "type": "array"
    },
    "extract_text": {
      "default": false,
      "type": "boolean"
    },
    "new_case": {
      "anyOf": [
        {
          "$ref": "#/$defs/CaseCreate"
        },
        {
          "type": "null"
        }
      ]
    },
    "paths": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "retention": {
      "anyOf": [
        {
          "$ref": "#/$defs/RetentionMode"
        },
        {
          "type": "null"
        }
      ],
      "description": "`copy` (default) snapshots `paths` into the workspace. `reference`\nhashes them without copying, for large files: the Artifacts are\n`external` and cannot satisfy an offline-completeness guarantee. A\nfailed copy is a failed ingest, never a fallback to `reference`."
    },
    "reverify": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReverifyRequest"
        },
        {
          "type": "null"
        }
      ],
      "description": "Compare the supplied bytes (one path or stdin) with an exact\nreference-only Artifact revision. A match records an attributed\nverification in a new revision and, for copied bytes, retains them. A\nmismatch records a failed verification; the recorded digest never\nchanges and records citing the Artifact need review."
    },
    "schema_version": {
      "$ref": "#/$defs/IngestVersion"
    },
    "source": {
      "$ref": "#/$defs/SourceManifest"
    }
  },
  "required": [
    "schema_version",
    "command_id",
    "actor",
    "source"
  ],
  "title": "Manifest",
  "type": "object"
}
