{
  "$defs": {
    "Actor": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:_.-]+$",
      "type": "string"
    },
    "ActorDescriptor": {
      "additionalProperties": false,
      "description": "Every field is self-reported, including kind; it is not an authentication claim.",
      "properties": {
        "harness": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "model_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ActorKind": {
      "enum": [
        "human",
        "agent"
      ],
      "type": "string"
    },
    "CaseCreate": {
      "additionalProperties": false,
      "description": "Payload for `case.create`; the engine assigns a durable case ID.",
      "properties": {
        "decision_relevance": {
          "type": [
            "string",
            "null"
          ]
        },
        "exclusions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expectations": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaseExpectations"
            },
            {
              "type": "null"
            }
          ]
        },
        "method_pins": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mode": {
          "$ref": "#/$defs/CaseMode",
          "default": "explore"
        },
        "objective": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy_pins": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge"
            },
            {
              "type": "null"
            }
          ]
        },
        "stop_condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Knowledge2"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "CaseExpectations": {
      "additionalProperties": false,
      "properties": {
        "expected_answer_or_choice": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "surprising_outcomes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "surprising_outcomes"
      ],
      "type": "object"
    },
    "CaseMode": {
      "enum": [
        "explain",
        "measure",
        "evaluate",
        "explore",
        "record"
      ],
      "type": "string"
    },
    "ClassificationLevel": {
      "enum": [
        "public",
        "internal",
        "restricted"
      ],
      "type": "string"
    },
    "Id": {
      "pattern": "^(case|q|src|art|obs|hyp|asm|opt|crit|cmp|assess|concl|dec|rev|obj|ann|retro|inq|run|tx|handle|checkpoint|import|ws)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "IngestVersion": {
      "enum": [
        "inv.ingest.v1"
      ],
      "type": "string"
    },
    "Knowledge": {
      "description": "Explicit unknown is distinct from a known zero, empty string, or empty list.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "known",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "Knowledge2": {
      "description": "Explicit unknown is distinct from a known zero, empty string, or empty list.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "known",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/StopCondition"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "SourceManifest": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Opaque producer metadata retained with the resulting Source.",
          "type": "object"
        },
        "producer": {
          "type": [
            "string",
            "null"
          ]
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "verification_limits": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "StopCondition": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/StopReason"
          },
          "type": "array"
        },
        "reopening_conditions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "residual_risks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "description",
        "reasons",
        "residual_risks",
        "reopening_conditions"
      ],
      "type": "object"
    },
    "StopReason": {
      "enum": [
        "question_answered",
        "choice_made",
        "conditional_decision_accepted",
        "uncertainty_tolerated",
        "insufficient_evidence",
        "prerequisite_unavailable",
        "cost_or_time_exhausted",
        "experiment_too_disruptive",
        "experiment_not_authorized",
        "volatile_evidence_preserved",
        "superseded_question",
        "investigator_pause"
      ],
      "type": "string"
    },
    "StreamContent": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "stdin",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "urn:investigation:schema:v1:wire:ingest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "actor_descriptor": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActorDescriptor"
        },
        {
          "type": "null"
        }
      ]
    },
    "case_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Id"
        },
        {
          "type": "null"
        }
      ]
    },
    "classification": {
      "$ref": "#/$defs/ClassificationLevel",
      "default": "internal"
    },
    "command_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "content": {
      "anyOf": [
        {
          "$ref": "#/$defs/StreamContent"
        },
        {
          "type": "null"
        }
      ]
    },
    "extract_text": {
      "default": false,
      "type": "boolean"
    },
    "new_case": {
      "anyOf": [
        {
          "$ref": "#/$defs/CaseCreate"
        },
        {
          "type": "null"
        }
      ]
    },
    "paths": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema_version": {
      "$ref": "#/$defs/IngestVersion"
    },
    "source": {
      "$ref": "#/$defs/SourceManifest"
    }
  },
  "required": [
    "schema_version",
    "command_id",
    "actor",
    "source"
  ],
  "title": "Manifest",
  "type": "object"
}
